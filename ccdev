#!/usr/bin/env bash
# ccdev – mosh/ssh into a host, attach/create byobu sessions (one per project dir), and run claude

set -euo pipefail

BYOBU_SESSION=""
USER_OVERRIDE=""
REMOTE_DIR=""
NO_SCREENSHOTS=0
NEW_SESSION=0
SYNC_AUTH=0
SERVER_CMD=""
BASE_DIR="${CCDEV_BASE:-}"   # Projekt-Basisverzeichnis auf dem Remote (--base > $CCDEV_BASE > dessen $HOME)
RESTORE=0
# Proxmox: ccdev ohne Host listet die LXC-Container mit diesem Tag (per SSH auf einen PVE-Knoten).
PVE_HOSTS="${CCDEV_PVE:-}"            # SSH-Ziele der PVE-Knoten, leerzeichengetrennt, erster erreichbarer gilt
PVE_TAG="${CCDEV_PVE_TAG:-claude}"
PVE_USER="${CCDEV_PVE_USER:-root}"    # Login für die gefundenen Container
# Screenshot-Verzeichnis: per --screenshot-dir / CCDEV_SCREENSHOT_DIR überschreibbar.
# Fallback: $HOME/Pictures/Screenshots, bei root ggf. das des aufrufenden Users (SUDO_USER).
if [[ -n "${CCDEV_SCREENSHOT_DIR:-}" ]]; then
  LOCAL_SCREENSHOT_DIR="$CCDEV_SCREENSHOT_DIR"
elif [[ $EUID -eq 0 && -n "${SUDO_USER:-}" && -d "/home/${SUDO_USER}/Pictures/Screenshots" ]]; then
  LOCAL_SCREENSHOT_DIR="/home/${SUDO_USER}/Pictures/Screenshots"
else
  LOCAL_SCREENSHOT_DIR="$HOME/Pictures/Screenshots"
fi

usage() {
  cat <<EOF
Usage: ccdev [OPTIONS] [user@]host [dir]
       ccdev [OPTIONS]                  # with \$CCDEV_PVE: pick a tagged Proxmox container

Options:
  -u, --user USER       SSH username (overrides user in user@host)
  -d, --dir  DIR        Directory to cd into on the remote before starting claude
  -n, --name NAME       byobu session name (default: basename of dir, else "claude")
  -s, --server CMD      Dev server command (overrides .ccdev on remote)
  -S, --screenshot-dir DIR  Local screenshot dir to watch
                            (default: \$HOME/Pictures/Screenshots, or CCDEV_SCREENSHOT_DIR)
      --no-screenshots  Disable automatic screenshot sync
      --new             Start a new Claude session (skip --resume)
      --base DIR        Remote base dir for projects (subdirs with CLAUDE.md or .ccdev;
                        default: \$CCDEV_BASE, else remote \$HOME;
                        relative paths are taken from the remote \$HOME)
      --restore         Start byobu sessions for all projects not running yet
                        (claude --continue), then show the session menu
      --sync-auth       Sync local Claude auth to remote host
  -h, --help            Show this help

Proxmox (optional):
  CCDEV_PVE="root@pve1 root@pve2"   SSH targets of PVE nodes (first reachable one is used)
  CCDEV_PVE_TAG=claude              only LXC containers with this tag (default: claude)
  CCDEV_PVE_USER=root               login user for those containers (default: root)
  Without a host, ccdev lists the tagged containers with their IPs to pick from.
  A host without "." or "@" is first matched against their names (unique prefix,
  e.g. "seedhodler" for seedhodler-dev); if nothing matches it goes to ssh as is.

Examples:
  ccdev root@192.168.1.10
  ccdev -u root 192.168.1.10
  ccdev root@192.168.1.10 /opt/myproject          # byobu session "myproject"
  ccdev -n homelab root@192.168.1.10
  ccdev -u root 192.168.1.10 -d /opt/myproject
  ccdev --restore root@192.168.1.10                 # after a reboot: restart all projects
EOF
  exit 0
}

# --- Parse arguments ---
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -u|--user)
      USER_OVERRIDE="$2"
      shift 2
      ;;
    -d|--dir)
      REMOTE_DIR="$2"
      shift 2
      ;;
    -n|--name)
      BYOBU_SESSION="$2"
      shift 2
      ;;
    -s|--server)
      SERVER_CMD="$2"
      shift 2
      ;;
    -S|--screenshot-dir)
      LOCAL_SCREENSHOT_DIR="$2"
      shift 2
      ;;
    --no-screenshots)
      NO_SCREENSHOTS=1
      shift
      ;;
    --sync-auth)
      SYNC_AUTH=1
      shift
      ;;
    --new)
      NEW_SESSION=1
      shift
      ;;
    --base)
      BASE_DIR="$2"
      shift 2
      ;;
    --restore)
      RESTORE=1
      shift
      ;;
    -h|--help)
      usage
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

# --- Proxmox: getaggte Container mit IP (Tab-getrennt: vmid node name status ip) ---
pve_list() {
  local h
  for h in $PVE_HOSTS; do
    ssh -o ConnectTimeout=5 -o BatchMode=yes "$h" python3 - "$PVE_TAG" <<'PY' 2>/dev/null && return 0
import json, subprocess, sys
from concurrent.futures import ThreadPoolExecutor
tag = sys.argv[1]
def get(*a):
    out = subprocess.run(["pvesh", "get", *a, "--output-format", "json"], capture_output=True, text=True).stdout
    return json.loads(out or "[]")
def ip(r):
    if r["status"] != "running":
        return "-"
    for i in get("/nodes/%s/lxc/%s/interfaces" % (r["node"], r["vmid"])):
        if i.get("name") != "lo" and i.get("inet"):
            return i["inet"].split("/")[0]
    return "-"
cts = sorted((r for r in get("/cluster/resources", "--type", "vm")
              if r["type"] == "lxc" and tag in (r.get("tags") or "").split(";")), key=lambda r: r["vmid"])
with ThreadPoolExecutor(8) as ex:
    ips = list(ex.map(ip, cts))
for r, a in zip(cts, ips):
    print(r["vmid"], r["node"], r["name"], r["status"], a, sep="\t")
PY
  done
  return 1
}

# Setzt TARGET auf PVE_USER@ip. $1 = Namensanfang (leer = alle). Rückgabe 1 = kein Treffer.
pve_pick() {
  local rows prefix="${1:-}" id node name st ip n
  if ! rows=$(pve_list); then
    echo "Warning: no Proxmox node reachable ($PVE_HOSTS)." >&2
    [[ -n "$prefix" ]] && return 1
    exit 1
  fi
  local -a ROWS=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    IFS=$'\t' read -r id node name st ip <<<"$line"
    [[ -z "$prefix" || "$name" == "$prefix"* ]] && ROWS+=("$line")
  done <<<"$rows"
  [[ ${#ROWS[@]} -eq 0 ]] && return 1
  if [[ ${#ROWS[@]} -eq 1 && -n "$prefix" ]]; then
    n=1
  else
    echo "Proxmox-Container mit Tag \"$PVE_TAG\":"
    for i in "${!ROWS[@]}"; do
      IFS=$'\t' read -r id node name st ip <<<"${ROWS[$i]}"
      [[ "$st" == running ]] || ip="(aus)"
      printf '  [%d] %-18s CT%-5s %-8s %s\n' $((i + 1)) "$name" "$id" "$node" "$ip"
    done
    read -rp "Auswahl: " n </dev/tty
    [[ "$n" =~ ^[0-9]+$ && "$n" -ge 1 && "$n" -le ${#ROWS[@]} ]] || { echo "Abbruch." >&2; exit 1; }
  fi
  IFS=$'\t' read -r id node name st ip <<<"${ROWS[$((n - 1))]}"
  [[ "$st" == running && "$ip" != "-" ]] || { echo "Error: CT$id $name is not running (or has no IP)." >&2; exit 1; }
  echo "→ $name (CT$id, $node): $PVE_USER@$ip"
  TARGET="$PVE_USER@$ip"
}

if [[ ${#POSITIONAL[@]} -eq 0 ]]; then
  if [[ -n "$PVE_HOSTS" ]]; then
    pve_pick "" || { echo "Error: no Proxmox container with tag \"$PVE_TAG\"." >&2; exit 1; }
  else
    echo "Error: no host specified." >&2
    usage
  fi
else
  TARGET="${POSITIONAL[0]}"
  if [[ -n "$PVE_HOSTS" && "$TARGET" != *[.@:]* ]]; then
    pve_pick "$TARGET" || true    # kein Treffer: Host unverändert an ssh (z. B. Alias aus ~/.ssh/config)
  fi
fi

if [[ ${#POSITIONAL[@]} -ge 2 && -z "$REMOTE_DIR" ]]; then
  REMOTE_DIR="${POSITIONAL[1]}"
fi

# byobu session name: explicit -n, else basename of dir, else "claude"
if [[ -z "$BYOBU_SESSION" ]]; then
  if [[ -n "$REMOTE_DIR" ]]; then
    BYOBU_SESSION="$(basename "$REMOTE_DIR")"
  else
    BYOBU_SESSION="claude"
  fi
fi
BYOBU_SESSION="${BYOBU_SESSION//[.:]/_}"   # tmux forbids . and : in session names

if [[ "$TARGET" == *@* ]]; then
  PARSED_USER="${TARGET%%@*}"
  HOST="${TARGET##*@}"
else
  PARSED_USER=""
  HOST="$TARGET"
fi

if [[ -n "$USER_OVERRIDE" ]]; then
  SSH_USER="$USER_OVERRIDE"
elif [[ -n "$PARSED_USER" ]]; then
  SSH_USER="$PARSED_USER"
else
  SSH_USER="$USER"
fi

SSH_TARGET="${SSH_USER}@${HOST}"

# --- Read .ccdev config from remote project dir ---
if [[ -z "$SERVER_CMD" && -n "$REMOTE_DIR" ]]; then
  REMOTE_SERVER_CMD=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}" \
    'test -f '"${REMOTE_DIR}"'/.ccdev && . '"${REMOTE_DIR}"'/.ccdev && echo "$SERVER_CMD"' 2>/dev/null || true)
  if [[ -n "$REMOTE_SERVER_CMD" ]]; then
    SERVER_CMD="$REMOTE_SERVER_CMD"
    echo "  ✓ .ccdev config gefunden: SERVER_CMD gesetzt"
  fi
fi

# --- Prüfe entr auf Remote wenn SERVER_CMD gesetzt ---
if [[ -n "$SERVER_CMD" ]]; then
  ENTR_OK=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}" 'command -v entr &>/dev/null && echo yes || echo no' 2>/dev/null || echo "no")
  if [[ "$ENTR_OK" != "yes" ]]; then
    echo "  ⚠ entr nicht auf Remote gefunden (nützlich für auto-restart des Dev-Servers)"
    read -rp "  entr auf ${SSH_TARGET} installieren? [j/N] " REPLY
    if [[ "$REPLY" =~ ^[jJ]$ ]]; then
      ssh -t "${SSH_TARGET}" "sudo apt-get update -qq && sudo apt-get install -y entr"
      echo "  ✓ entr installiert"
    fi
  fi
fi

# This script runs on the remote host.
# Kopf: Einstellungen sauber quotiert; Rumpf: Programm unverändert (quoted heredoc, keine \$-Maskierung nötig).
REMOTE_HEAD=$(printf 'BYOBU_SESSION=%q\nREMOTE_DIR=%q\nNEW_SESSION=%q\nSERVER_CMD=%q\nBASE_DIR=%q\nRESTORE=%q\n' \
  "$BYOBU_SESSION" "$REMOTE_DIR" "$NEW_SESSION" "$SERVER_CMD" "$BASE_DIR" "$RESTORE")
REMOTE_BODY=$(cat <<'REMOTE'
set -euo pipefail

# Wird von ccdev auf dem Zielrechner ausgeführt. Davor setzt ccdev:
# BYOBU_SESSION REMOTE_DIR NEW_SESSION SERVER_CMD BASE_DIR RESTORE
BASE_DIR="${BASE_DIR:-$HOME}"
[[ "$BASE_DIR" != /* ]] && BASE_DIR="$HOME/$BASE_DIR"   # relativ = unter dem $HOME des Zielrechners
CD_CMD=""
[[ -n "$REMOTE_DIR" ]] && CD_CMD="cd $(printf '%q' "$REMOTE_DIR") && "

# --- Projekte: Unterordner von BASE_DIR mit CLAUDE.md oder .ccdev ---
proj_key()     { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }        # Claude-Projektordner-Name
proj_hist()    { echo "$HOME/.claude/projects/$(proj_key "$1")"; }
has_history()  { ls "$(proj_hist "$1")"/*.jsonl >/dev/null 2>&1; }
last_activity() {
  local f; f=$(ls -t "$(proj_hist "$1")"/*.jsonl 2>/dev/null | head -1 || true)
  if [[ -n "$f" ]]; then date -r "$f" +%d.%m.%Y; else echo "neu"; fi
}
sname() { local n; n=$(basename "$1"); echo "${n//[.:]/_}"; }

list_projects() {   # nur Projekte ohne laufende byobu-Session
  local d
  for d in "$BASE_DIR"/*/; do
    d="${d%/}"
    [[ -f "$d/CLAUDE.md" || -f "$d/.ccdev" ]] || continue
    byobu has-session -t "=$(sname "$d")" 2>/dev/null && continue
    echo "$d"
  done
}

start_project() {   # $1 = Projektordner; startet die byobu-Session im Hintergrund
  local d="$1" n srv cl qd
  n=$(sname "$d"); qd=$(printf '%q' "$d")
  byobu has-session -t "=$n" 2>/dev/null && return 0
  byobu new-session -d -s "$n" -c "$d"
  srv=""
  [[ -f "$d/.ccdev" ]] && srv=$(bash -c '. "$1/.ccdev" >/dev/null 2>&1; echo "${SERVER_CMD:-}"' _ "$d")
  cl="claude"; has_history "$d" && cl="claude --continue"
  if [[ -n "$srv" ]]; then
    byobu split-window -h -t "$n:0"
    byobu send-keys -t "$n:0.1" "cd $qd && $srv" Enter
    byobu send-keys -t "$n:0.0" "cd $qd && $cl" Enter
  else
    byobu send-keys -t "$n:0" "cd $qd && $cl" Enter
  fi
  echo "  ✓ gestartet: $n  ($d, $([[ $cl == *continue ]] && echo "letzte Sitzung fortgesetzt" || echo "neue Sitzung"))"
}

restore_all() {
  local d any=0
  while IFS= read -r d; do [[ -n "$d" ]] && { start_project "$d"; any=1; }; done < <(list_projects)
  [[ $any -eq 1 ]] || echo "  (keine gespeicherten Projekte ohne laufende Session)"
}

new_session() {
  if byobu has-session -t "=${BYOBU_SESSION}" 2>/dev/null; then
    echo "→ byobu-Session '${BYOBU_SESSION}' existiert bereits, verbinde …"
    byobu attach-session -t "=${BYOBU_SESSION}"
    return
  fi
  echo "→ Starte neue byobu-Session '${BYOBU_SESSION}' …"
  byobu new-session -s "${BYOBU_SESSION}" -d
  local cl="claude --resume"
  [[ "${NEW_SESSION}" -eq 1 ]] && cl="claude"
  if [[ -n "${SERVER_CMD}" ]]; then
    # Split-Pane Layout: Claude links, Server rechts
    byobu split-window -h -t "${BYOBU_SESSION}:0"
    byobu send-keys -t "${BYOBU_SESSION}:0.1" "${CD_CMD}${SERVER_CMD}" Enter
    byobu send-keys -t "${BYOBU_SESSION}:0.0" "${CD_CMD}${cl}" Enter
  else
    byobu send-keys -t "${BYOBU_SESSION}:0" "${CD_CMD}${cl}" Enter
  fi
  byobu attach-session -t "=${BYOBU_SESSION}"
}

# --- Menü ---
SESSION_NAMES=(); PROJECTS=()
load_lists() {
  SESSION_NAMES=(); PROJECTS=()
  local s
  while IFS= read -r s; do [[ -n "$s" ]] && SESSION_NAMES+=("$s"); done < <(byobu list-sessions -F '#{session_name}' 2>/dev/null || true)
  while IFS= read -r s; do [[ -n "$s" ]] && PROJECTS+=("$s"); done < <(list_projects)
}
show_menu() {
  local i=1 s line info
  echo ""
  if [[ ${#SESSION_NAMES[@]} -gt 0 ]]; then
    echo "Aktive byobu-Sessions:"
    echo "──────────────────────────────────────"
    while IFS= read -r line; do
      [[ -n "$line" ]] && echo "  [$i] $line" && i=$((i + 1))
    done < <(byobu list-sessions 2>/dev/null || true)
  fi
  if [[ ${#PROJECTS[@]} -gt 0 ]]; then
    echo "Gespeicherte Projekte (nicht gestartet) in $BASE_DIR:"
    echo "──────────────────────────────────────"
    for s in "${PROJECTS[@]}"; do
      if has_history "$s"; then info="zuletzt $(last_activity "$s")"; else info="noch kein Verlauf"; fi
      printf "  [%d] %-14s %s, %s\n" "$i" "$(sname "$s")" "$s" "$info"
      i=$((i + 1))
    done
  fi
  echo "──────────────────────────────────────"
  [[ ${#PROJECTS[@]} -gt 0 ]] && echo "  [r] Alle gespeicherten Projekte starten"
  echo "  [n] Neue Session erstellen"
  echo "  [q] Abbrechen"
  echo ""
}

if [[ "${RESTORE}" -eq 1 ]]; then
  echo "→ Starte alle gespeicherten Projekte in $BASE_DIR …"
  restore_all
fi

load_lists
if [[ ${#SESSION_NAMES[@]} -eq 0 && ${#PROJECTS[@]} -eq 0 ]]; then
  echo "Keine byobu-Sessions gefunden."
  new_session
  exit 0
fi
if [[ ${#SESSION_NAMES[@]} -eq 0 && -n "$REMOTE_DIR" ]]; then
  new_session          # wie bisher: mit Verzeichnis und ohne laufende Sessions direkt starten
  exit 0
fi

show_menu
while true; do
  read -rp "Wahl: " CHOICE
  NS=${#SESSION_NAMES[@]}; NP=${#PROJECTS[@]}

  if [[ "$CHOICE" == "q" ]]; then
    echo "Abgebrochen."
    exit 0
  fi

  if [[ "$CHOICE" == "r" && $NP -gt 0 ]]; then
    restore_all
    load_lists; show_menu
    continue
  fi

  if [[ "$CHOICE" == "n" ]]; then
    read -rp "Name der neuen Session [${BYOBU_SESSION}]: " NAME
    NAME="${NAME:-$BYOBU_SESSION}"
    BYOBU_SESSION="${NAME//[.:]/_}"
    new_session
    exit 0
  fi

  if [[ "$CHOICE" =~ ^[0-9]+$ ]] && (( CHOICE >= 1 && CHOICE <= NS + NP )); then
    if (( CHOICE > NS )); then
      P="${PROJECTS[$(( CHOICE - NS - 1 ))]}"
      start_project "$P"
      byobu attach-session -t "=$(sname "$P")"
      exit 0
    fi
    SELECTED="${SESSION_NAMES[$(( CHOICE - 1 ))]}"
    echo ""
    echo "  [a] Attachen"
    echo "  [k] Killen"
    echo "  [b] Zurück"
    read -rp "Aktion für '$SELECTED': " ACTION
    case "$ACTION" in
      a)
        byobu attach-session -t "=$SELECTED"
        exit 0
        ;;
      k)
        byobu kill-session -t "=$SELECTED"
        echo "Session '$SELECTED' beendet."
        load_lists
        if [[ ${#SESSION_NAMES[@]} -eq 0 && ${#PROJECTS[@]} -eq 0 ]]; then
          echo "Keine Sessions mehr vorhanden."
          read -rp "Neue Session erstellen? [j/n]: " YN
          [[ "$YN" == "j" ]] && new_session
          exit 0
        fi
        show_menu
        ;;
      b)
        show_menu
        ;;
      *)
        echo "Ungültige Aktion."
        ;;
    esac
  else
    echo "Ungültige Eingabe."
  fi
done
REMOTE
)
REMOTE_CMD="#!/usr/bin/env bash
${REMOTE_HEAD}
${REMOTE_BODY}"

QUOTED_CMD="$(printf '%q' "$REMOTE_CMD")"

# --- Preflight: Lokale Dependencies ---
LOCAL_FAIL=0
for tool in mosh ssh scp; do
  if ! command -v "$tool" &>/dev/null; then
    echo "✗ Lokal fehlt: $tool" >&2
    LOCAL_FAIL=1
  fi
done
[[ "$LOCAL_FAIL" -eq 1 ]] && exit 1

# --- Preflight: Remote Dependencies ---
echo "🔍 Prüfe Remote-Dependencies auf ${SSH_TARGET}…"
REMOTE_CHECK=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}" \
  'export PATH="$HOME/.npm-global/bin:$PATH"; MISSING=(); for t in byobu mosh-server claude; do command -v "$t" &>/dev/null || MISSING+=("$t"); done; echo "${MISSING[*]}"' 2>&1)
SSH_RC=$?

if [[ "$SSH_RC" -ne 0 ]]; then
  echo "✗ SSH-Verbindung zu ${SSH_TARGET} fehlgeschlagen:" >&2
  echo "  $REMOTE_CHECK" >&2
  exit 1
fi

if [[ -n "$REMOTE_CHECK" ]]; then
  echo "✗ Remote fehlen folgende Tools: $REMOTE_CHECK"
  echo ""

  APT_MISSING=""
  CLAUDE_MISSING=0
  for t in $REMOTE_CHECK; do
    case "$t" in
      claude)      CLAUDE_MISSING=1 ;;
      mosh-server) APT_MISSING="$APT_MISSING mosh" ;;
      *)           APT_MISSING="$APT_MISSING $t" ;;
    esac
  done

  read -rp "  Jetzt auf ${SSH_TARGET} installieren? [j/N] " REPLY
  if [[ ! "$REPLY" =~ ^[jJ]$ ]]; then
    echo "Abgebrochen." >&2
    exit 1
  fi

  if [[ -n "$APT_MISSING" ]]; then
    echo "  ⬇ Installiere via apt:${APT_MISSING}…"
    ssh -t "${SSH_TARGET}" "sudo apt-get update -qq && sudo apt-get install -y${APT_MISSING}"
  fi

  if [[ "$CLAUDE_MISSING" -eq 1 ]]; then
    echo "  ⬇ Prüfe Node.js…"
    ssh -t "${SSH_TARGET}" 'bash -lc "
      NODE_OK=0
      if command -v node &>/dev/null; then
        NODE_VER=\$(node -e \"process.stdout.write(process.version.slice(1).split(\\\".\\\")[0])\")
        [ \"\$NODE_VER\" -ge 18 ] && NODE_OK=1
      fi
      if [ \"\$NODE_OK\" -eq 0 ]; then
        echo \"  ⬇ Installiere Node.js 20...\"
        curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -
        sudo apt-get install -y nodejs
      else
        echo \"  ✓ Node.js \$(node --version)\"
      fi
      # npm sicherstellen (Ubuntu apt nodejs enthält es nicht immer)
      if ! command -v npm &>/dev/null; then
        echo \"  ⬇ Installiere npm...\"
        sudo apt-get install -y npm
      fi
      echo \"  ⬇ Setze npm prefix...\"
      mkdir -p ~/.npm-global
      npm config set prefix ~/.npm-global
      echo \"  ⬇ Installiere claude...\"
      PATH=\"\$HOME/.npm-global/bin:\$PATH\" npm install -g @anthropic-ai/claude-code
      grep -qxF \"export PATH=\\\"\\\$HOME/.npm-global/bin:\\\$PATH\\\"\" ~/.bashrc \
        || echo \"export PATH=\\\"\\\$HOME/.npm-global/bin:\\\$PATH\\\"\" >> ~/.bashrc
      echo \"  ✓ claude installiert\"
    "'
  fi

  # Nochmal prüfen ob Installation erfolgreich war
  echo ""
  echo "🔍 Prüfe erneut…"
  REMOTE_CHECK=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}" \
    'export PATH="$HOME/.npm-global/bin:$PATH"; MISSING=(); for t in byobu mosh-server claude; do command -v "$t" &>/dev/null || MISSING+=("$t"); done; echo "${MISSING[*]}"' 2>&1)
  if [[ -n "$REMOTE_CHECK" ]]; then
    echo "✗ Installation fehlgeschlagen, fehlen noch: $REMOTE_CHECK" >&2
    exit 1
  fi
fi
echo "  ✓ Remote-Dependencies OK"
echo ""


# --- Claude Auth prüfen und ggf. von lokal übertragen ---
if [[ "$SYNC_AUTH" -eq 1 ]]; then
echo "🔑 Prüfe Claude-Auth auf ${SSH_TARGET}…"
REMOTE_AUTH=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}"   'test -f ~/.claude/.credentials.json && echo "ok" || (grep -q "oauthAccount\|apiKey" ~/.claude/settings.json 2>/dev/null && echo "ok" || echo "missing")' 2>/dev/null || echo "missing")

if [[ "$REMOTE_AUTH" != "ok" ]]; then
  echo "  ⚠ Keine Claude-Auth auf Remote gefunden"

  # Lokale Auth prüfen
  LOCAL_AUTH_OK=0
  if [[ -f "$HOME/.claude/.credentials.json" ]] || \
     grep -q "oauthAccount\|apiKey" "$HOME/.claude/settings.json" 2>/dev/null; then
    LOCAL_AUTH_OK=1
  fi

  if [[ "$LOCAL_AUTH_OK" -eq 0 ]]; then
    echo "  ✗ Auch lokal keine Claude-Auth gefunden." >&2
    echo "    Bitte zuerst lokal \'claude\' starten und einloggen, dann erneut verbinden." >&2
    exit 1
  fi

  read -rp "  Lokale Auth (~/.claude/) auf ${SSH_TARGET} übertragen? [j/N] " REPLY
  if [[ "$REPLY" =~ ^[jJ]$ ]]; then
    echo "  ⬆ Übertrage ~/.claude/…"
    ssh "${SSH_TARGET}" "mkdir -p ~/.claude"
    # Nur Auth-relevante Dateien — keine projektspezifischen Settings
    for f in .credentials.json settings.json; do
      [[ -f "$HOME/.claude/$f" ]] && scp -q "$HOME/.claude/$f" "${SSH_TARGET}:~/.claude/$f"
    done
    echo "  ✓ Auth übertragen"
  else
    echo "  ⚠ Auth nicht übertragen — claude wird nach Login fragen"
  fi
else
  echo "  ✓ Claude-Auth OK"
fi
fi
echo ""

# --- Screenshot-Watcher ---
INOTIFY_PID=""
LOOP_PID=""
WATCH_FIFO=""
if [[ "$NO_SCREENSHOTS" -eq 0 ]]; then
  if ! command -v inotifywait &>/dev/null; then
    echo "⚠ inotifywait nicht gefunden — Screenshot-Sync deaktiviert (inotify-tools installieren oder --no-screenshots nutzen)"
  elif [[ ! -d "$LOCAL_SCREENSHOT_DIR" ]]; then
    echo "⚠ Screenshot-Verzeichnis nicht gefunden: $LOCAL_SCREENSHOT_DIR — Screenshot-Sync deaktiviert"
  else
    # Remote-Ziel: screenshots/ im Projektverzeichnis, oder ~/screenshots als Fallback
    if [[ -n "$REMOTE_DIR" ]]; then
      REMOTE_SCREENSHOT_DIR="${REMOTE_DIR}/screenshots"
    else
      REMOTE_SCREENSHOT_DIR="~/screenshots"
    fi

    ssh "${SSH_TARGET}" "mkdir -p ${REMOTE_SCREENSHOT_DIR}" 2>/dev/null

    # --- /ss Slash-Command auf Remote anlegen ---
    # Projektspezifisch wenn REMOTE_DIR gesetzt, sonst global
    if [[ -n "$REMOTE_DIR" ]]; then
      SS_CMD_DIR="${REMOTE_DIR}/.claude/commands"
    else
      SS_CMD_DIR="~/.claude/commands"
    fi

    TMPSS=$(mktemp)
    cat > "$TMPSS" <<SSEOF
Schau dir die neuesten Screenshots im Verzeichnis ${REMOTE_SCREENSHOT_DIR}/ an.
Sortiere nach Dateiname absteigend (neueste zuerst).

Falls \$ARGUMENTS eine Zahl ist, lies die entsprechende Anzahl der neuesten Screenshots.
Falls \$ARGUMENTS Text ist, lies den neuesten Screenshot und beantworte die Frage dazu.
Falls \$ARGUMENTS leer ist, lies den neuesten Screenshot und beschreibe was du siehst.
SSEOF
    ssh "${SSH_TARGET}" "mkdir -p ${SS_CMD_DIR}" 2>/dev/null
    scp -q "$TMPSS" "${SSH_TARGET}:${SS_CMD_DIR}/ss.md"
    rm -f "$TMPSS"
    echo "  ✓ /ss Slash-Command auf Remote erstellt (${SS_CMD_DIR})"

    echo "📸 Screenshot-Watcher aktiv → ${SSH_TARGET}:${REMOTE_SCREENSHOT_DIR}"

    # close_write deckt Tools ab, die direkt schreiben (GNOME);
    # moved_to deckt Tools ab, die in eine Temp-Datei schreiben und atomar
    # umbenennen (Flameshot, Spectacle, KDE …).
    # inotifywait und die Sync-Schleife laufen als getrennte Prozesse über
    # einen FIFO, damit beim Cleanup BEIDE PIDs eindeutig bekannt sind und
    # inotifywait nicht verwaist zurückbleibt.
    WATCH_FIFO=$(mktemp -u)
    mkfifo "$WATCH_FIFO"

    inotifywait -m -e close_write -e moved_to "$LOCAL_SCREENSHOT_DIR" \
      --format '%f' 2>/dev/null > "$WATCH_FIFO" &
    INOTIFY_PID=$!

    (
      while read -r FILE; do
        DATETIME=$(date '+%Y%m%d-%H%M%S')
        DEST="${REMOTE_SCREENSHOT_DIR}/cp-${DATETIME}.png"
        scp "$LOCAL_SCREENSHOT_DIR/$FILE" "${SSH_TARGET}:${DEST}" 2>/dev/null \
          && ssh "${SSH_TARGET}" "echo \"\$(date +%H:%M:%S) ✓ $FILE → ${DEST}\" >> ${REMOTE_SCREENSHOT_DIR}/../cc-watcher.log"
      done < "$WATCH_FIFO"
    ) &
    LOOP_PID=$!
  fi
fi

cleanup() {
  [[ -n "$INOTIFY_PID" ]] && kill "$INOTIFY_PID" 2>/dev/null
  [[ -n "$LOOP_PID" ]]    && kill "$LOOP_PID" 2>/dev/null
  wait "$INOTIFY_PID" "$LOOP_PID" 2>/dev/null
  [[ -n "$WATCH_FIFO" ]] && rm -f "$WATCH_FIFO"
  [[ -n "$INOTIFY_PID$LOOP_PID" ]] && echo "🛑 Screenshot-Watcher gestoppt"
}
trap cleanup EXIT

if command -v mosh &>/dev/null; then
  echo "→ Connecting to ${SSH_TARGET} via mosh …"
  mosh "$SSH_TARGET" -- bash -lc "$REMOTE_CMD"
else
  echo "→ mosh not found, falling back to ssh …"
  ssh -t "$SSH_TARGET" "bash -lc ${QUOTED_CMD}"
fi

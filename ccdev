#!/usr/bin/env bash
# ccdev – mosh/ssh into a host, attach/create byobu sessions (one per project dir), and run claude

set -euo pipefail

VERSION="2.0.1-dev"
BYOBU_SESSION=""
USER_OVERRIDE=""
REMOTE_DIR=""
NO_SCREENSHOTS=0
START="continue"  # Claude-Start: continue (Standard), fresh (--new), pick (--pick)
START_CLI=""
SYNC_AUTH=0     # --copy-login
TRANSPORT=auto  # auto (mosh wenn vorhanden), mosh, ssh; --ssh / [settings] transport
TRANSPORT_CLI=""
DRY_RUN=0       # --dry-run
SS_DIR_CLI=0    # --screenshot-dir gesetzt
CFG_SS_DIR=""   # [settings] screenshot_dir
CFG_SCREENSHOTS=""   # [settings] screenshots = off
SERVER_CMD=""
BASE_DIR="${CCDEV_BASE:-}"   # Projekt-Basisverzeichnis auf dem Remote (--base > $CCDEV_BASE > dessen $HOME)
RESTORE=0
PERM_MODE=""    # --mode / [settings] permission_mode: an claude --permission-mode durchgereicht
MODE_CLI=""
# Inventar: benannte Ziele aus Quellen der Konfigurationsdatei (siehe usage); ccdev ohne Host zeigt sie zur Auswahl.
CONFIG_FILE="${CCDEV_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/ccdev/config}"
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/ccdev/inventory.tsv"
CACHE_TTL=300   # Sekunden, in denen der Cache ohne Live-Abfrage gilt ([settings] cache_ttl; 0 = immer live)
REFRESH=0       # --refresh
INIT=0          # --init
LIST_FMT=""     # --list table|tsv|json, intern names (für die Vervollständigung)
INV_NOTE=""     # Herkunft der zuletzt gelesenen Liste, z. B. "cached 2 min ago"
# Screenshot-Verzeichnis: per --screenshot-dir / CCDEV_SCREENSHOT_DIR überschreibbar.
# Fallback: $HOME/Pictures/Screenshots, bei root ggf. das des aufrufenden Users (SUDO_USER).
if [[ -n "${CCDEV_SCREENSHOT_DIR:-}" ]]; then
  LOCAL_SCREENSHOT_DIR="$CCDEV_SCREENSHOT_DIR"
elif [[ $EUID -eq 0 && -n "${SUDO_USER:-}" && -d "/home/${SUDO_USER}/Pictures/Screenshots" ]]; then
  LOCAL_SCREENSHOT_DIR="/home/${SUDO_USER}/Pictures/Screenshots"
else
  LOCAL_SCREENSHOT_DIR="$HOME/Pictures/Screenshots"
fi

# --- Hilfe: -h kurz, --help vollständig mit "Your setup", --help THEMA ---
HELP=""         # short | full | Thema; ausgegeben nach dem Einlesen der Argumente
HELP_TOPICS="inventory projects env"
DOCS_URL="https://github.com/efnats/ccdev"

help_short() {
  cat <<EOF
ccdev $VERSION - run Claude Code on a remote host in persistent byobu sessions

Usage: ccdev [OPTIONS] [HOST|NAME] [DIR]

  ccdev                         pick a host from your inventory
  ccdev root@10.0.0.5           session manager on that host
  ccdev myhost /opt/app         open a project (own session, Claude continues)
  ccdev --restore myhost        after a reboot: start all saved projects

Common options:
  -u USER       ssh user               --new        new Claude conversation
  -n NAME       session name           --pick       choose a conversation
  --base DIR    where projects live    --mode MODE  Claude permission mode (auto, plan, ...)
  --ssh         ssh instead of mosh    --dry-run    show what would happen
  --init        set up the inventory   --list       show the inventory

More: ccdev --help (all options), ccdev --help inventory|projects|env
Docs: $DOCS_URL
EOF
}

help_full() {
  cat <<EOF
ccdev $VERSION - run Claude Code on a remote host in persistent byobu sessions

Usage: ccdev [OPTIONS] [HOST|NAME] [DIR]

  HOST  user@host, an address or an ssh alias
  NAME  a target from your host inventory: exact name, unique prefix or SOURCE/NAME
  DIR   project directory on the host; gets its own byobu session named after it

Examples:
  ccdev                               pick a host from your inventory
  ccdev root@10.0.0.5                 session manager: running sessions, saved projects
  ccdev myhost /opt/app               open a project, Claude continues where it left off
  ccdev --restore myhost              after a reboot: start all saved projects
  ccdev --mode auto myhost /opt/app   Claude works without asking, risky actions blocked
  ccdev --dry-run myhost /opt/app     show target, transport and Claude command only

Connection:
  -u, --user USER          ssh user (overrides user@ in HOST; default: ssh decides)
      --ssh                use ssh even if mosh is installed (e.g. UDP blocked)
      --copy-login         copy your local Claude login (~/.claude/.credentials.json)
                           to the host if it has none

Projects and sessions:
  -n, --name NAME          byobu session name (default: name of DIR, else "claude")
      --base DIR           where to look for projects (default: \$CCDEV_BASE, else
                           the remote \$HOME; relative paths start at the remote \$HOME)
      --restore            start sessions for all saved projects, then the menu

Claude (for sessions ccdev starts; default: continue the last conversation):
      --new                start a new conversation
      --pick               choose a conversation from Claude's list
      --mode MODE          permission mode, e.g. manual, acceptEdits, auto, plan
                           (default: [settings] permission_mode, else the host's
                           Claude settings)

Host inventory:
      --init               set up the sources interactively
      --list [FORMAT]      print the inventory: table (default), tsv or json
      --refresh            query the sources live instead of using the cache

Screenshots and dev server:
      --dev CMD            run CMD in a split pane next to Claude (overrides .ccdev)
      --screenshot-dir DIR local screenshot dir to watch (default: \$CCDEV_SCREENSHOT_DIR,
                           else [settings] screenshot_dir, else ~/Pictures/Screenshots)
      --no-screenshots     don't copy screenshots to the host

Other:
      --dry-run            resolve everything, print it, connect to nothing
  -h                       short help
      --help [TOPIC]       this help, or a topic: ${HELP_TOPICS// /, }
      --completion bash    print the bash completion script
      --version            print the version

EOF
  help_setup
  cat <<EOF

More: ccdev --help inventory|projects|env
Docs: $DOCS_URL (config format: docs/inventory.md)
EOF
}

# Aktueller Stand, ohne Netzwerkzugriff
help_setup() {
  local h="$HOME" n age names
  names=$(IFS=,; echo "${SRC_NAME[*]}"); names="${names//,/, }"
  echo "Your setup:"
  if [[ -f "$CONFIG_FILE" ]]; then
    printf '  %-12s %s (%d source(s)%s)\n' "config" "${CONFIG_FILE/#$h/\~}" "${#SRC_NAME[@]}" \
      "${names:+: $names}"
  elif [[ ${#SRC_NAME[@]} -gt 0 ]]; then
    printf '  %-12s %s\n' "config" "none, CCDEV_PVE defines one proxmox source"
  else
    printf '  %-12s %s\n' "config" "none (ccdev --init sets up a host inventory)"
  fi
  if [[ -s "$CACHE_FILE" ]]; then
    n=$(grep -c . "$CACHE_FILE"); age=$(cache_age)
    printf '  %-12s %s (%d target(s), %s old)\n' "cache" "${CACHE_FILE/#$h/\~}" "$n" \
      "$( (( age < 120 )) && echo "${age} s" || echo "$((age / 60)) min")"
  fi
  if [[ -n "${CCDEV_BASE:-}" ]]; then
    printf '  %-12s %s\n' "CCDEV_BASE" "$CCDEV_BASE$([[ "$CCDEV_BASE" != /* ]] && echo " (~/$CCDEV_BASE on each host)")"
  else
    printf '  %-12s %s\n' "CCDEV_BASE" "not set (projects in the remote \$HOME)"
  fi
  printf '  %-12s %s\n' "mode" "${PERM_MODE:-not set (Claude settings on the host decide)}"
  printf '  %-12s %s\n' "transport" "$TRANSPORT$([[ $TRANSPORT == auto ]] && { command -v mosh &>/dev/null && echo " (mosh found)" || echo " (no mosh, ssh)"; })"
}

help_topic() {
  case "$1" in
    inventory) cat <<'TOPIC'
ccdev host inventory: connect by name instead of address

  ccdev                    menu of all targets, grouped by source
  ccdev NAME               exact name, else unique prefix; several hits show a menu
  ccdev SOURCE/NAME        only look in one source
  ccdev --init             set up the sources interactively
  ccdev --list [FORMAT]    table, tsv or json      ccdev --refresh   skip the cache

A HOST containing ".", "@" or ":" always goes to ssh unchanged, and so does a
NAME that matches nothing. Stopped targets are shown as (off), running guests
without an address as (no IP).

Config file: ~/.config/ccdev/config (or $CCDEV_CONFIG), one block per source:

  [source NAME]          NAME is shown in the menu and used for SOURCE/NAME
  type = static          host = NAME TARGET [INFO]          (repeatable)
  type = ssh-config      match = GLOB...    Host aliases from ~/.ssh/config (default: *)
                         marker = WORD      only Host lines carrying "# WORD"
                         file = PATH...     (default: ~/.ssh/config)
  type = proxmox-ssh     nodes = root@pve1 root@pve2   (first reachable one is used)
                         tag = claude       guests with this tag (default: claude)
                         types = lxc qemu   containers and/or VMs (default: both;
                                            VM addresses need the QEMU guest agent)
                         user = root        login user for the guests (default: root)
  type = command         run = CMD          prints NAME<TAB>TARGET[<TAB>STATUS[<TAB>INFO]]
                         timeout = 20       seconds

  [settings]             cache_ttl = 300          seconds the cache is used as is
                                                  (0 = always query live)
                         permission_mode = auto   default for --mode
                         transport = auto         auto (mosh if installed), mosh or ssh
                         screenshot_dir = DIR     default for --screenshot-dir
                         screenshots = off        like --no-screenshots

Comments start with # or ;, also at the end of a line except in run.
Cache: ~/.cache/ccdev/inventory.tsv, refreshed in the background; a failing
source keeps its last entries, marked (cached).
Without a config file, CCDEV_PVE ("root@pve1 root@pve2"), CCDEV_PVE_TAG and
CCDEV_PVE_USER define one proxmox-ssh source.
TOPIC
      ;;
    projects) cat <<'TOPIC'
ccdev projects and sessions

A project is a subdirectory of the base dir on the host that contains a
CLAUDE.md or a .ccdev file. Every project gets its own byobu session, named
after the directory.

  ccdev HOST               menu: running sessions, then saved projects (not running)
  ccdev HOST DIR           no session running yet: start DIR's session right away;
                           otherwise the menu, where [n] creates it
  ccdev --restore HOST     start all saved projects (after a reboot), then the menu
  ccdev --base DIR HOST    look for projects in DIR

Menu keys: a number attaches to a session or starts a project, [r] starts all
saved projects, [n] creates a new session, [q] quits; for a session [a]ttach,
[k]ill or [b]ack.

Claude starts with "claude --continue" (the last conversation in that directory,
plain "claude" without history); --new starts a new one, --pick shows Claude's
list of conversations to choose from.
The base dir defaults to the remote $HOME; CCDEV_BASE or --base change it, and
a relative value starts at the remote $HOME (CCDEV_BASE=claude is /root/claude
for root, /home/alice/claude for alice).

Dev server: a .ccdev file in the project with SERVER_CMD="npm run dev" splits
new sessions, Claude on the left, the server on the right (or --dev CMD).
TOPIC
      ;;
    env) cat <<'TOPIC'
ccdev environment and files

Environment:
  CCDEV_BASE             default for --base (relative to the remote $HOME)
  CCDEV_CONFIG           inventory config file (default ~/.config/ccdev/config)
  CCDEV_SCREENSHOT_DIR   default for --screenshot-dir
  CCDEV_PVE, CCDEV_PVE_TAG, CCDEV_PVE_USER
                         legacy: one proxmox-ssh source when there is no config file
  XDG_CONFIG_HOME, XDG_CACHE_HOME   respected for config and cache

Local files:
  ~/.config/ccdev/config           host inventory and settings
  ~/.cache/ccdev/inventory.tsv     inventory cache

On the host:
  <project>/.claude/commands/ss.md, or ~/.claude/commands/ss.md    the /ss command
  <project>/screenshots/, or ~/screenshots/, and cc-watcher.log     copied screenshots
  ~/.claude/.credentials.json                                       only with --copy-login
  byobu sessions, one per project or name

Tools are only installed on the host after you confirm a prompt (sudo apt-get,
Node.js via NodeSource, claude via npm into ~/.npm-global).
TOPIC
      ;;
    *)
      echo "ccdev: no help topic '$1'. Topics: $HELP_TOPICS" >&2
      exit 2
      ;;
  esac
}

# Kurze Fehlermeldung statt der ganzen Hilfe
die_usage() { echo "ccdev: $1" >&2; echo "Try 'ccdev -h' or 'ccdev --help'." >&2; exit 2; }
need_arg() { [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die_usage "$1 needs a value"; }

completion_script() {
  [[ "$1" == bash ]] || { echo "Error: only bash is supported (zsh: autoload bashcompinit; bashcompinit)." >&2; exit 1; }
  cat <<'COMP'
# bash completion for ccdev, load with: eval "$(ccdev --completion bash)"
_ccdev() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" w i n=0
  case "$prev" in
    -u|--user|-n|--name|--dev|--base) return ;;
    --screenshot-dir) COMPREPLY=($(compgen -d -- "$cur")); return ;;
    --list) COMPREPLY=($(compgen -W "table tsv json" -- "$cur")); return ;;
    --completion) COMPREPLY=($(compgen -W "bash" -- "$cur")); return ;;
    --help) COMPREPLY=($(compgen -W "inventory projects env" -- "$cur")); return ;;
    --mode) COMPREPLY=($(compgen -W "manual acceptEdits auto plan dontAsk bypassPermissions" -- "$cur")); return ;;
  esac
  if [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "-u --user -n --name --dev --screenshot-dir --no-screenshots --new --pick
      --base --restore --copy-login --mode --ssh --dry-run --init --refresh --list --completion -h --help
      --version" -- "$cur"))
    return
  fi
  # nur das erste Positionsargument (Host oder Name) vervollständigen
  for ((i = 1; i < COMP_CWORD; i++)); do
    w="${COMP_WORDS[i]}"
    case "$w" in
      -u|--user|-n|--name|--dev|--screenshot-dir|--base|--completion|--mode) ((i++)) ;;
      -*) ;;
      *) n=$((n + 1)) ;;
    esac
  done
  [[ $n -eq 0 ]] || return
  local -a names=($(compgen -W "$(ccdev --names 2>/dev/null)" -- "$cur"))
  if declare -F _known_hosts_real >/dev/null; then
    _known_hosts_real -a -- "$cur"
  else
    COMPREPLY=()
  fi
  COMPREPLY=("${names[@]}" "${COMPREPLY[@]}")
}
complete -F _ccdev ccdev
COMP
}

# --- Parse arguments ---
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -u|--user)
      need_arg "$@"
      USER_OVERRIDE="$2"
      shift 2
      ;;
    -d|--dir|-s|--server|-S|--sync-auth|--fresh)   # in 2.0.0 entfernt
      case "$1" in
        -d|--dir)    die_usage "$1 was removed in 2.0.0; give the directory as the second argument" ;;
        -s|--server) die_usage "$1 was removed in 2.0.0; use --dev" ;;
        -S)          die_usage "-S was removed in 2.0.0; use --screenshot-dir" ;;
        --sync-auth) die_usage "--sync-auth was removed in 2.0.0; use --copy-login" ;;
        --fresh)     die_usage "--fresh was removed in 2.0.0; use --new" ;;
      esac
      ;;
    -n|--name)
      need_arg "$@"
      BYOBU_SESSION="$2"
      shift 2
      ;;
    --dev)
      need_arg "$@"
      SERVER_CMD="$2"
      shift 2
      ;;
    --screenshot-dir)
      need_arg "$@"
      LOCAL_SCREENSHOT_DIR="$2"
      SS_DIR_CLI=1
      shift 2
      ;;
    --no-screenshots)
      NO_SCREENSHOTS=1
      shift
      ;;
    --copy-login)
      SYNC_AUTH=1
      shift
      ;;
    --new)
      [[ "$START_CLI" == pick ]] && die_usage "--new and --pick exclude each other"
      START_CLI=fresh
      shift
      ;;
    --pick)
      [[ "$START_CLI" == fresh ]] && die_usage "--new and --pick exclude each other"
      START_CLI=pick
      shift
      ;;
    --ssh)
      TRANSPORT_CLI=ssh
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --base)
      need_arg "$@"
      BASE_DIR="$2"
      shift 2
      ;;
    --restore)
      RESTORE=1
      shift
      ;;
    --mode)
      need_arg "$@"
      MODE_CLI="$2"
      shift 2
      ;;
    --version)
      echo "ccdev $VERSION"
      exit 0
      ;;
    --refresh)
      REFRESH=1
      shift
      ;;
    --init)
      INIT=1
      shift
      ;;
    --list)
      LIST_FMT=table
      if [[ "${2:-}" =~ ^(table|tsv|json)$ ]]; then LIST_FMT="$2"; shift; fi
      shift
      ;;
    --names)   # intern: Namen aus dem Cache, für die Vervollständigung
      LIST_FMT=names
      shift
      ;;
    --completion)
      completion_script "${2:-bash}"
      exit 0
      ;;
    -h)
      HELP=short
      shift
      ;;
    --help)
      HELP=full
      if [[ -n "${2:-}" && "$2" != -* ]]; then HELP="$2"; shift; fi   # Thema, unbekannte meldet help_topic
      shift
      ;;
    -*)
      die_usage "unknown option: $1"
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

# --- Inventar: Quellen aus der Konfigurationsdatei ---
SRC_NAME=(); SRC_TYPE=(); declare -A SRC_OPT=()   # SRC_OPT["i:key"], wiederholte Schlüssel zeilenweise

load_config() {
  local line key val i=-1 n=0
  local re_src='^\[source[[:space:]]+([^]]+)\]$' re_kv='^([A-Za-z_]+)[[:space:]]*=[[:space:]]*(.*)$'
  if [[ -f "$CONFIG_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      n=$((n + 1))
      line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
      [[ -z "$line" || "$line" == [\#\;]* ]] && continue
      if [[ "$line" =~ $re_src ]]; then
        i=${#SRC_NAME[@]}; SRC_NAME[i]="${BASH_REMATCH[1]}"; SRC_TYPE[i]=""
      elif [[ "$line" == "[settings]" ]]; then
        i=-2
      elif [[ $i -ne -1 && "$line" =~ $re_kv ]]; then
        key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
        if [[ "$key" != run ]]; then   # Kommentar am Zeilenende (nicht bei run, Befehle dürfen # enthalten)
          val="${val%%[[:space:]]#*}"; val="${val%"${val##*[![:space:]]}"}"
        fi
        if [[ $i -eq -2 ]]; then
          case "$key" in
            cache_ttl) [[ "$val" =~ ^[0-9]+$ ]] && CACHE_TTL="$val" || echo "Warning: $CONFIG_FILE:$n cache_ttl must be a number" >&2 ;;
            permission_mode) PERM_MODE="$val" ;;
            transport) [[ "$val" =~ ^(auto|mosh|ssh)$ ]] && TRANSPORT="$val" || echo "Warning: $CONFIG_FILE:$n transport must be auto, mosh or ssh" >&2 ;;
            screenshot_dir) CFG_SS_DIR="$val" ;;
            screenshots) [[ "$val" =~ ^(on|off)$ ]] && CFG_SCREENSHOTS="$val" || echo "Warning: $CONFIG_FILE:$n screenshots must be on or off" >&2 ;;
            *) echo "Warning: $CONFIG_FILE:$n unknown setting: $key" >&2 ;;
          esac
        elif [[ "$key" == type ]]; then
          SRC_TYPE[i]="$val"
        else
          SRC_OPT["$i:$key"]+="${SRC_OPT["$i:$key"]:+$'\n'}$val"
        fi
      else
        echo "Warning: $CONFIG_FILE:$n ignored: $line" >&2
      fi
    done <"$CONFIG_FILE"
  elif [[ -n "${CCDEV_PVE:-}" ]]; then   # Altform per Umgebung
    SRC_NAME=(proxmox); SRC_TYPE=(proxmox-ssh)
    SRC_OPT["0:nodes"]="$CCDEV_PVE"
    SRC_OPT["0:tag"]="${CCDEV_PVE_TAG:-claude}"
    SRC_OPT["0:user"]="${CCDEV_PVE_USER:-root}"
  fi
}
opt() { echo "${SRC_OPT["$1:$2"]:-${3:-}}"; }   # opt INDEX KEY [DEFAULT]

# Jede Quelle gibt Zeilen NAME<TAB>ZIEL<TAB>STATUS<TAB>INFO aus.
src_static() {
  local l name target info
  while IFS= read -r l; do
    read -r name target info <<<"$l"
    [[ -n "$target" ]] && printf '%s\t%s\t?\t%s\n' "$name" "$target" "$info"
  done <<<"$(opt "$1" host)"
}

# shellcheck disable=SC2254  # match-Werte sind bewusst Muster
src_ssh_config() {
  local - i="$1" f l a m ok marker globs aliases comment hn
  set -f   # Muster nicht gegen Dateien expandieren
  local re_host='^[[:space:]]*[Hh][Oo][Ss][Tt][[:space:]]+([^#]*)(#.*)?$'
  marker=$(opt "$i" marker); globs=$(opt "$i" match '*')
  for f in $(opt "$i" file "$HOME/.ssh/config"); do
    f="${f/#\~/$HOME}"; [[ -f "$f" ]] || continue
    while IFS= read -r l; do
      [[ "$l" =~ $re_host ]] || continue
      aliases="${BASH_REMATCH[1]}"; comment="${BASH_REMATCH[2]:-}"
      [[ -n "$marker" && "$comment" != *"$marker"* ]] && continue
      for a in $aliases; do
        [[ "$a" == *[\*\?\!]* ]] && continue
        ok=0; for m in $globs; do case "$a" in $m) ok=1 ;; esac; done
        [[ $ok -eq 1 ]] || continue
        hn=$(ssh -G -F "$f" "$a" </dev/null 2>/dev/null | awk '$1 == "user" {u = $2} $1 == "hostname" {h = $2} END {print u "@" h}')
        printf '%s\t%s\t?\t%s\n' "$a" "$a" "$hn"
      done
    done <"$f"
  done
}

src_proxmox_ssh() {
  local i="$1" h user rows id node name st ip kind note
  user=$(opt "$i" user root)
  for h in $(opt "$i" nodes); do
    # ssh fügt die Argumente zu einer Befehlszeile zusammen, daher quotieren
    rows=$(ssh -o ConnectTimeout=5 -o BatchMode=yes "$h" \
      "python3 - $(printf '%q ' "$(opt "$i" tag claude)" "$(opt "$i" types "lxc qemu")")" <<'PY' 2>/dev/null
import json, subprocess, sys
from concurrent.futures import ThreadPoolExecutor
tag, types = sys.argv[1], sys.argv[2].split()
def get(*a):
    try:
        out = subprocess.run(["pvesh", "get", *a, "--output-format", "json"],
                             capture_output=True, text=True, timeout=10).stdout
        return json.loads(out or "null")
    except (subprocess.TimeoutExpired, ValueError):
        return None
def addr(r):   # (IP oder "-", Hinweis)
    if r["status"] != "running":
        return "-", ""
    if r["type"] == "lxc":
        for i in get("/nodes/%s/lxc/%s/interfaces" % (r["node"], r["vmid"])) or []:
            if i.get("name") != "lo" and i.get("inet"):
                return i["inet"].split("/")[0], ""
        return "-", "no IPv4"
    res = get("/nodes/%s/qemu/%s/agent/network-get-interfaces" % (r["node"], r["vmid"]))
    if not isinstance(res, dict) or not res.get("result"):
        return "-", "no guest agent"
    for i in res["result"]:
        if i.get("name") == "lo":
            continue
        for a in i.get("ip-addresses") or []:
            if a.get("ip-address-type") == "ipv4" and not a.get("ip-address", "").startswith("127."):
                return a["ip-address"], ""
    return "-", "no IPv4"
vms = sorted((r for r in get("/cluster/resources", "--type", "vm") or []
              if r.get("type") in types and tag in (r.get("tags") or "").split(";")), key=lambda r: r["vmid"])
with ThreadPoolExecutor(8) as ex:
    addrs = list(ex.map(addr, vms))
for r, (a, note) in zip(vms, addrs):
    print(r["vmid"], r["node"], r["name"], r["status"], a, r["type"], note, sep="\t")
PY
) || continue
    while IFS=$'\t' read -r id node name st ip kind note; do
      [[ -z "$id" ]] && continue
      [[ "$ip" == - ]] || ip="$user@$ip"
      [[ "$kind" == qemu ]] && kind=VM || kind=CT
      printf '%s\t%s\t%s\t%s\n' "$name" "$ip" "$st" "$kind$id $node${note:+, $note}"
    done <<<"$rows"
    return 0
  done
  echo "no node reachable ($(opt "$i" nodes | tr '\n' ' '))" >&2
  return 1
}

src_command() {
  local cmd t
  cmd=$(opt "$1" run); t=$(opt "$1" timeout 20)
  [[ -n "$cmd" ]] || { echo "run = … missing" >&2; return 1; }
  if command -v timeout &>/dev/null; then timeout "$t" bash -c "$cmd"; else bash -c "$cmd"; fi
}

# Live-Abfrage aller Quellen parallel. $1 bekommt QUELLE<TAB>NAME<TAB>ZIEL<TAB>STATUS<TAB>INFO
# in Konfigurationsreihenfolge, $2 die Namen ausgefallener Quellen.
inventory_live() {
  local out="$1" failed="$2" tmp i fn name target st info
  : >"$out"; : >"$failed"
  tmp=$(mktemp -d)
  for i in "${!SRC_NAME[@]}"; do
    case "${SRC_TYPE[i]}" in
      static)      fn=src_static ;;
      ssh-config)  fn=src_ssh_config ;;
      proxmox-ssh) fn=src_proxmox_ssh ;;
      command)     fn=src_command ;;
      *) echo "Warning: source '${SRC_NAME[i]}': unknown type '${SRC_TYPE[i]}'" >&2; continue ;;
    esac
    ( "$fn" "$i" >"$tmp/$i" 2>"$tmp/$i.err" \
        || { : >"$tmp/$i.failed"; echo "Warning: source '${SRC_NAME[i]}' failed: $(head -1 "$tmp/$i.err")" >&2; } ) &
  done
  wait
  for i in "${!SRC_NAME[@]}"; do
    [[ -f "$tmp/$i" ]] || continue
    if [[ -f "$tmp/$i.failed" ]]; then echo "${SRC_NAME[i]}" >>"$failed"; continue; fi
    while IFS=$'\t' read -r name target st info; do
      [[ -n "$name" && -n "$target" ]] || continue
      printf '%s\t%s\t%s\t%s\t%s\n' "${SRC_NAME[i]}" "$name" "$target" "${st:-?}" "$info"
    done <"$tmp/$i" >>"$out"
  done
  rm -rf "$tmp"
}

cache_age() { echo $(( $(date +%s) - $(date -r "$CACHE_FILE" +%s) )); }
cache_fresh() {
  (( CACHE_TTL > 0 )) && [[ -s "$CACHE_FILE" && ! "$CONFIG_FILE" -nt "$CACHE_FILE" ]] && (( $(cache_age) < CACHE_TTL ))
}

# Live abfragen und den Cache schreiben; ausgefallene Quellen behalten ihre letzten Einträge aus dem Cache
# (dann bleibt der alte Zeitstempel, damit der nächste Aufruf wieder live fragt). Ausgabe nach $1,
# Einträge aus dem Cache dort mit "(cached)" markiert.
inventory_refresh() {
  local out="$1" tmp s
  tmp=$(mktemp -d)
  inventory_live "$tmp/rows" "$tmp/failed"
  if [[ -s "$tmp/failed" && -f "$CACHE_FILE" ]]; then
    while IFS= read -r s; do
      awk -F'\t' -v s="$s" '$1 == s' "$CACHE_FILE" >>"$tmp/rows"
    done <"$tmp/failed"
  fi
  mkdir -p "$(dirname "$CACHE_FILE")"
  cp "$tmp/rows" "$CACHE_FILE.$$"
  [[ -s "$tmp/failed" && -f "$CACHE_FILE" ]] && touch -r "$CACHE_FILE" "$CACHE_FILE.$$"
  mv -f "$CACHE_FILE.$$" "$CACHE_FILE"
  if [[ -s "$tmp/failed" ]]; then
    awk -F'\t' -v OFS='\t' 'NR == FNR {f[$0] = 1; next} ($1 in f) {$5 = $5 ($5 == "" ? "" : " ") "(cached)"} 1' \
      "$tmp/failed" "$tmp/rows" >"$out"
  else
    cp "$tmp/rows" "$out"
  fi
  rm -rf "$tmp"
}

# Cache im Hintergrund erneuern (höchstens ein Lauf gleichzeitig).
refresh_background() {
  local lock="$CACHE_FILE.lock"
  mkdir -p "$(dirname "$CACHE_FILE")"
  if ! mkdir "$lock" 2>/dev/null; then
    [[ -n "$(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null)" ]] || return 0   # anderer Lauf aktiv
    rm -rf "$lock"; mkdir "$lock" 2>/dev/null || return 0
  fi
  ( trap 'rm -rf "$lock"' EXIT; inventory_refresh /dev/null ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

# Inventar nach $1: aus dem Cache, solange er frisch ist (dann Erneuerung im Hintergrund), sonst live.
inventory() {
  local age
  if [[ $REFRESH -eq 0 ]] && cache_fresh; then
    cp "$CACHE_FILE" "$1"
    age=$(cache_age)
    if (( age < 60 )); then INV_NOTE="cached ${age} s ago"; else INV_NOTE="cached $((age / 60)) min ago"; fi
    refresh_background
  else
    INV_NOTE=""
    inventory_refresh "$1"
  fi
}

json_str() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }

# --list: Inventar ausgeben (table, tsv, json); names: nur Namen aus dem Cache, ohne Netz.
list_inventory() {
  local inv src name target st info first=1
  if [[ "$1" == names ]]; then
    [[ -s "$CACHE_FILE" ]] && awk -F'\t' '{print $2; print $1 "/" $2}' "$CACHE_FILE" | sort -u
    if [[ ${#SRC_NAME[@]} -gt 0 ]] && ! cache_fresh; then refresh_background; fi
    return 0
  fi
  [[ ${#SRC_NAME[@]} -gt 0 ]] || { echo "Error: no host inventory configured ($CONFIG_FILE)." >&2; exit 1; }
  inv=$(mktemp)
  inventory "$inv"
  case "$1" in
    tsv) cat "$inv" ;;
    json)
      printf '['
      while IFS=$'\t' read -r src name target st info; do
        [[ $first -eq 1 ]] || printf ','
        first=0
        printf '\n  {"source": %s, "name": %s, "target": %s, "status": %s, "info": %s}' \
          "$(json_str "$src")" "$(json_str "$name")" "$(json_str "$target")" "$(json_str "$st")" "$(json_str "$info")"
      done <"$inv"
      printf '\n]\n'
      ;;
    *)
      { printf 'SOURCE\tNAME\tTARGET\tSTATUS\tINFO\n'; cat "$inv"; } \
        | if command -v column &>/dev/null; then column -t -s $'\t'; else cat; fi
      [[ -z "$INV_NOTE" ]] || echo "($INV_NOTE, --refresh queries live)" >&2
      ;;
  esac
  rm -f "$inv"
}

is_up() { [[ "$2" != - ]] && case "$1" in stopped|down|off|offline) false ;; *) true ;; esac; }

# Setzt TARGET. $1 = Name, Namensanfang oder QUELLE/NAME (leer = alle zeigen). Rückgabe 1 = kein Treffer.
pick_target() {
  local want="${1:-}" wsrc="" wname l pass src name target st info n="" last=""
  local -a ALL=() HIT=()
  local inv; inv=$(mktemp)
  inventory "$inv"
  while IFS= read -r l; do [[ -n "$l" ]] && ALL+=("$l"); done <"$inv"
  rm -f "$inv"
  if [[ -z "$want" ]]; then
    HIT=("${ALL[@]}")
  else
    wname="$want"
    [[ "$want" == */* ]] && { wsrc="${want%%/*}"; wname="${want#*/}"; }
    for pass in exact prefix; do
      for l in "${ALL[@]}"; do
        IFS=$'\t' read -r src name target st info <<<"$l"
        [[ -n "$wsrc" && "$src" != "$wsrc" ]] && continue
        if [[ $pass == exact && "$name" == "$wname" ]] || [[ $pass == prefix && "$name" == "$wname"* ]]; then
          HIT+=("$l")
        fi
      done
      [[ ${#HIT[@]} -gt 0 ]] && break
    done
  fi
  [[ ${#HIT[@]} -eq 0 ]] && return 1
  if [[ ${#HIT[@]} -eq 1 && -n "$want" ]]; then
    n=1
  else
    echo "Targets${INV_NOTE:+ ($INV_NOTE)}:"
    for i in "${!HIT[@]}"; do
      IFS=$'\t' read -r src name target st info <<<"${HIT[$i]}"
      [[ "$src" != "$last" ]] && { echo "  $src"; last="$src"; }
      is_up "$st" x || target="(off)"
      [[ "$target" == - ]] && target="(no IP)"
      printf '    [%d] %-18s %-24s %s\n' $((i + 1)) "$name" "$target" "$info"
    done
    read -rp "Choice: " n </dev/tty || true
    [[ "$n" =~ ^[0-9]+$ && "$n" -ge 1 && "$n" -le ${#HIT[@]} ]] || { echo "Aborted." >&2; exit 1; }
  fi
  IFS=$'\t' read -r src name target st info <<<"${HIT[$((n - 1))]}"
  if ! is_up "$st" "$target"; then
    if is_up "$st" x; then echo "Error: $src/$name has no address${info:+ ($info)}." >&2
    else echo "Error: $src/$name is $st.${INV_NOTE:+ --refresh queries live.}" >&2; fi
    exit 1
  fi
  echo "→ $name ($src${info:+, $info}): $target"
  TARGET="$target"
}

# --- ccdev --init: Host-Inventar interaktiv einrichten ---
ask() {   # ask VAR "question" [default]
  local v=""
  read -rp "$2${3:+ [$3]}: " v </dev/tty || true
  printf -v "$1" '%s' "${v:-${3:-}}"
}

# Name für eine neue Quelle erfragen; nicht leer, ohne ], nicht schon vergeben ($1 = Vorschlag, $2 = Datei mit
# den neuen Blöcken; beim Ergänzen zählen auch die Quellen der vorhandenen Datei, INIT_KEEP)
ask_source_name() {
  local n
  while true; do
    ask n "  Source name (shown in the menu)" "$1"
    if [[ -z "$n" || "$n" == *[][[:space:]/]* ]]; then
      echo "  Please use a name without spaces, / or brackets."
    elif grep -qxF "[source $n]" "$2" ${INIT_KEEP:+"$INIT_KEEP"} 2>/dev/null; then
      echo "  A source '$n' already exists."
    else
      SRC_NEW_NAME="$n"; return
    fi
  done
}

init_static() {
  local name target info n=0
  echo "  Enter hosts (empty name to finish). Target e.g. root@192.168.1.10 or an ssh alias." >&2
  while true; do
    ask name "  Name"
    [[ -z "$name" ]] && break
    [[ "$name" == *[.@:[:space:]]* ]] && { echo "  Names must not contain . @ : or spaces, otherwise they cannot be used as a name." >&2; continue; }
    ask target "  Target for $name"
    [[ -n "$target" ]] || { echo "  No target, skipped." >&2; continue; }
    ask info "  Info (optional)"
    echo "host = $name $target${info:+ $info}"
    n=$((n + 1))
  done
  [[ $n -gt 0 ]]
}

# shellcheck disable=SC2254  # match-Werte sind bewusst Muster
init_ssh_config() {
  local f="$HOME/.ssh/config" aliases match hits=0 a m
  [[ -f "$f" ]] || { echo "  $f does not exist." >&2; return 1; }
  aliases=$(awk 'tolower($1) == "host" {for (i = 2; i <= NF && $i !~ /^#/; i++) if ($i !~ /[*?!]/) print $i}' "$f")
  [[ -n "$aliases" ]] || { echo "  No host aliases in $f." >&2; return 1; }
  echo "  Host aliases in $f:" $aliases >&2
  ask match "  Which ones? Glob patterns, space-separated" "*"
  local -; set -f
  for a in $aliases; do for m in $match; do case "$a" in $m) hits=$((hits + 1)); break ;; esac; done; done
  echo "  → $hits alias(es) match." >&2
  echo "match = $match"
}

# Prüft einen Proxmox-Knoten per SSH; bei Erfolg 0, sonst der Grund auf stderr
pve_check() {
  local t="$1" out rc user why
  out=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$t" \
    'for c in pvesh python3; do command -v "$c" >/dev/null || echo "missing:$c"; done' 2>&1 </dev/null) && rc=0 || rc=$?
  if [[ $rc -eq 0 && "$out" != *missing:* ]]; then
    echo "  ✓ $t reachable (pvesh, python3)" >&2
    return 0
  fi
  if [[ "$t" == *@* ]]; then user="${t%%@*}"; else user=$(ssh -G "$t" 2>/dev/null | awk '$1 == "user" {print $2}'); fi
  if [[ $rc -eq 0 ]]; then
    why="logged in, but missing on the host: $(grep -o 'missing:[a-z0-9]*' <<<"$out" | cut -d: -f2 | tr '\n' ' ')(not a Proxmox node?)"
  else
    case "$out" in
      *"Permission denied"*)          why="login refused for user '$user': no SSH key accepted (ssh-copy-id $t, or check the user)" ;;
      *"Host key verification failed"*) why="host key not known yet: connect once with 'ssh $t' and accept it" ;;
      *"Could not resolve hostname"*) why="host name not found" ;;
      *"Connection refused"*)         why="SSH port closed (connection refused)" ;;
      *"timed out"*|*"No route to host"*|*"Network is unreachable"*) why="not reachable (timeout or no route)" ;;
      *)                              why="ssh failed: $(head -1 <<<"$out")" ;;
    esac
  fi
  echo "  ✗ $t: $why" >&2
  return 1
}

init_proxmox() {
  local nodes="" tag user types n u yn ok=0
  ask n "  SSH targets of the Proxmox nodes, space-separated (e.g. root@pve1 root@pve2)" "${CCDEV_PVE:-}"
  [[ -n "$n" ]] || { echo "  No nodes, no source." >&2; return 1; }
  # Ohne Benutzer entscheidet ssh; ist dort nur der lokale Benutzer zu erwarten, root vorschlagen
  for u in $n; do
    if [[ "$u" != *@* ]]; then
      user=$(ssh -G "$u" 2>/dev/null | awk '$1 == "user" {print $2}')
      if [[ -z "$user" || "$user" == "$(id -un)" ]]; then
        ask yn "  No user given for $u, ssh would log in as '${user:-$(id -un)}'. Use root@$u instead? [Y/n]"
        [[ -z "$yn" || "$yn" == [jJyY]* ]] && u="root@$u"
      else
        echo "  $u: user '$user' from ~/.ssh/config" >&2
      fi
    fi
    nodes+="${nodes:+ }$u"
  done
  for u in $nodes; do pve_check "$u" && ok=1; done
  [[ $ok -eq 1 ]] || { ask yn "  Keep it anyway? [y/N]"; [[ "$yn" == [jJyY]* ]] || return 1; }
  ask tag "  Tag of the guests" "${CCDEV_PVE_TAG:-claude}"
  ask types "  Containers and/or VMs (lxc qemu)" "lxc qemu"
  ask user "  Login user for the guests" "${CCDEV_PVE_USER:-root}"
  printf 'nodes = %s\ntag   = %s\ntypes = %s\nuser  = %s\n' "$nodes" "$tag" "$types" "$user"
}

init_command() {
  local run out
  echo "  The command prints one line per target: NAME<TAB>TARGET[<TAB>STATUS[<TAB>INFO]]" >&2
  ask run "  Command"
  [[ -n "$run" ]] || return 1
  out=$( (command -v timeout &>/dev/null && timeout 20 bash -c "$run" || bash -c "$run") 2>&1 ) || true
  echo "  Test run, $(grep -c . <<<"$out") line(s), first ones:" >&2
  head -5 <<<"$out" | sed 's/\t/ → /g; s/^/    /' >&2
  grep -q $'\t' <<<"$out" || echo "  ⚠ No tabs in the output, the format is probably not right yet." >&2
  echo "run  = $run"
}

init_config() {
  local new mode=new c fn type body go
  INIT_KEEP=""
  [[ -r /dev/tty ]] || { echo "Error: --init needs a terminal." >&2; exit 1; }
  new=$(mktemp)
  echo "ccdev: set up the host inventory ($CONFIG_FILE)"
  echo "Authentication to the targets (SSH keys, ~/.ssh/config) is up to you."
  if [[ -f "$CONFIG_FILE" ]]; then
    echo; echo "Existing configuration:"; sed 's/^/  | /' "$CONFIG_FILE"; echo
    ask c "[a]ppend, [r]eplace (the old file is backed up), [c]ancel" a
    case "$c" in a|A) mode=append; INIT_KEEP="$CONFIG_FILE" ;; r|R) mode=new ;; *) echo "Cancelled."; rm -f "$new"; exit 0 ;; esac
  elif [[ -n "${CCDEV_PVE:-}" ]]; then
    echo "Note: CCDEV_PVE is set; the Proxmox source suggests its values."
  fi
  while true; do
    echo
    echo "Add a source:"
    echo "  [1] static       fixed list of hosts"
    echo "  [2] ssh-config   host aliases from ~/.ssh/config"
    echo "  [3] proxmox-ssh  Proxmox containers/VMs with a tag (pvesh over SSH)"
    echo "  [4] command      your own command prints the list"
    echo "  [d] done"
    ask c "Choice" d
    case "$c" in
      1) type="static";      fn=init_static;     ask_source_name servers "$new" ;;
      2) type="ssh-config";  fn=init_ssh_config; ask_source_name ssh "$new" ;;
      3) type="proxmox-ssh"; fn=init_proxmox;    ask_source_name proxmox "$new" ;;
      4) type="command";     fn=init_command;    ask_source_name cmd "$new" ;;
      d|D|f|F) break ;;
      *) echo "Invalid choice."; continue ;;
    esac
    if body=$("$fn"); then
      printf '\n[source %s]\ntype = %s\n%s\n' "$SRC_NEW_NAME" "$type" "$body" >>"$new"
      echo "  ✓ Source '$SRC_NEW_NAME' added."
    else
      echo "  Source dropped."
    fi
  done
  if [[ ! -s "$new" ]]; then echo "No source added, nothing changed."; rm -f "$new"; exit 0; fi
  echo; echo "To be $([[ $mode == append ]] && echo "appended to" || echo "written to") $CONFIG_FILE:"
  sed 's/^/  | /' "$new"
  ask go "Save? [Y/n]"
  [[ -z "$go" || "$go" == [jJyY]* ]] || { echo "Nothing changed."; rm -f "$new"; exit 0; }
  mkdir -p "$(dirname "$CONFIG_FILE")"
  if [[ $mode == new ]]; then
    if [[ -f "$CONFIG_FILE" ]]; then
      local bak; bak="$CONFIG_FILE.bak-$(date +%Y%m%d-%H%M%S)"
      cp -p "$CONFIG_FILE" "$bak"
      echo "Old configuration backed up: $bak"
    fi
    { echo "# ccdev host inventory, created by ccdev --init (see ccdev --help)"; cat "$new"; } >"$CONFIG_FILE"
  else
    cat "$new" >>"$CONFIG_FILE"
  fi
  rm -f "$new"
  echo "✓ Saved. Current inventory:"; echo
  REFRESH=1; SRC_NAME=(); SRC_TYPE=(); SRC_OPT=()
  load_config
  list_inventory table || true
  if [[ -f "$HOME/.bashrc" ]] && ! grep -q 'ccdev --completion' "$HOME/.bashrc"; then
    echo; ask go "Add tab completion to ~/.bashrc? [y/N]"
    if [[ "$go" == [jJyY]* ]]; then
      printf '\n# ccdev: tab completion\neval "$(ccdev --completion bash 2>/dev/null)"\n' >>"$HOME/.bashrc"
      echo "✓ Added, takes effect in new shells."
    fi
  fi
  echo; echo "Done. Run ccdev (menu) or ccdev NAME."
}

if [[ $INIT -eq 1 ]]; then
  init_config
  exit 0
fi
load_config
PERM_MODE="${MODE_CLI:-$PERM_MODE}"   # --mode schlägt [settings] permission_mode
START="${START_CLI:-$START}"
[[ -n "$TRANSPORT_CLI" ]] && TRANSPORT="$TRANSPORT_CLI"
if [[ $SS_DIR_CLI -eq 0 && -z "${CCDEV_SCREENSHOT_DIR:-}" && -n "$CFG_SS_DIR" ]]; then
  LOCAL_SCREENSHOT_DIR="${CFG_SS_DIR/#\~/$HOME}"
fi
[[ "$CFG_SCREENSHOTS" == off ]] && NO_SCREENSHOTS=1
case "$HELP" in
  "") ;;
  short) help_short; exit 0 ;;
  full) help_full; exit 0 ;;
  *) help_topic "$HELP"; exit 0 ;;
esac
[[ -z "$PERM_MODE" || "$PERM_MODE" =~ ^[A-Za-z]+$ ]] || { echo "Error: invalid permission mode: $PERM_MODE" >&2; exit 1; }
if [[ -n "$LIST_FMT" ]]; then
  list_inventory "$LIST_FMT"
  exit 0
fi
if [[ ${#POSITIONAL[@]} -eq 0 ]]; then
  if [[ ${#SRC_NAME[@]} -gt 0 ]]; then
    pick_target "" || { echo "Error: no targets found in the inventory ($CONFIG_FILE)." >&2; exit 1; }
  else
    help_short
    exit 1
  fi
else
  TARGET="${POSITIONAL[0]}"
  if [[ ${#SRC_NAME[@]} -gt 0 && "$TARGET" != *[.@:]* ]]; then
    pick_target "$TARGET" || true   # kein Treffer: Host unverändert an ssh
  fi
fi

if [[ ${#POSITIONAL[@]} -ge 2 ]]; then
  REMOTE_DIR="${POSITIONAL[1]}"
fi

# byobu session name: explicit -n, else basename of dir, else "claude"
if [[ -z "$BYOBU_SESSION" ]]; then
  if [[ -n "$REMOTE_DIR" ]]; then
    BYOBU_SESSION="$(basename "$REMOTE_DIR")"
  else
    BYOBU_SESSION="claude"
  fi
fi
BYOBU_SESSION="${BYOBU_SESSION//[.:]/_}"   # tmux forbids . and : in session names

if [[ "$TARGET" == *@* ]]; then
  PARSED_USER="${TARGET%%@*}"
  HOST="${TARGET##*@}"
else
  PARSED_USER=""
  HOST="$TARGET"
fi

if [[ -n "$USER_OVERRIDE" ]]; then
  SSH_USER="$USER_OVERRIDE"
elif [[ -n "$PARSED_USER" ]]; then
  SSH_USER="$PARSED_USER"
else
  SSH_USER=""   # ssh entscheidet: User aus ~/.ssh/config, sonst lokaler Benutzer
fi

SSH_TARGET="${SSH_USER:+${SSH_USER}@}${HOST}"

# --- Transport: mosh oder ssh ---
USE_MOSH=0
case "$TRANSPORT" in
  ssh)  TRANSPORT_WHY="ssh (--ssh or transport = ssh)" ;;
  mosh) command -v mosh &>/dev/null || { echo "✗ transport = mosh, but mosh is not installed locally" >&2; exit 1; }
        USE_MOSH=1; TRANSPORT_WHY="mosh (transport = mosh)" ;;
  *)    if command -v mosh &>/dev/null; then USE_MOSH=1; TRANSPORT_WHY="mosh"; else TRANSPORT_WHY="ssh (mosh not installed locally)"; fi ;;
esac

# --- --dry-run: alles auflösen und anzeigen, nichts kontaktieren ---
if [[ $DRY_RUN -eq 1 ]]; then
  cl="claude${PERM_MODE:+ --permission-mode $PERM_MODE}"
  tilde='~'   # nur zur Anzeige
  case "$START" in
    fresh) cl="$cl" ;;
    pick)  cl="$cl --resume" ;;
    *)     cl="$cl --continue (plain \"${cl}\" if there is no history yet)" ;;
  esac
  echo "Dry run, nothing is contacted:"
  printf '  %-13s %s\n' "target" "$SSH_TARGET"
  printf '  %-13s %s\n' "user" "${SSH_USER:-decided by ssh (~/.ssh/config, else $USER)}"
  printf '  %-13s %s\n' "transport" "$TRANSPORT_WHY"
  if [[ -n "$REMOTE_DIR" ]]; then
    printf '  %-13s %s\n' "project" "$REMOTE_DIR (byobu session \"$BYOBU_SESSION\")"
  else
    printf '  %-13s %s\n' "project" "none: session manager, projects in ${BASE_DIR:-the remote \$HOME}"
  fi
  printf '  %-13s %s\n' "claude" "$cl"
  [[ $RESTORE -eq 1 ]] && printf '  %-13s %s\n' "restore" "start all saved projects first"
  printf '  %-13s %s\n' "dev command" "${SERVER_CMD:-from .ccdev on the host, if there is one}"
  if [[ $NO_SCREENSHOTS -eq 1 ]]; then
    printf '  %-13s %s\n' "screenshots" "off"
  else
    printf '  %-13s %s\n' "screenshots" "$LOCAL_SCREENSHOT_DIR → ${REMOTE_DIR:-$tilde}/screenshots/ on the host"
  fi
  # shellcheck disable=SC2088  # Anzeigetext, die Tilde soll nicht expandiert werden
  [[ $SYNC_AUTH -eq 1 ]] && printf '  %-13s %s\n' "login copy" "~/.claude/.credentials.json, if the host has no login"
  exit 0
fi

# --- Read .ccdev config from remote project dir ---
if [[ -z "$SERVER_CMD" && -n "$REMOTE_DIR" ]]; then
  REMOTE_SERVER_CMD=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}" \
    'test -f '"${REMOTE_DIR}"'/.ccdev && . '"${REMOTE_DIR}"'/.ccdev && echo "$SERVER_CMD"' 2>/dev/null || true)
  if [[ -n "$REMOTE_SERVER_CMD" ]]; then
    SERVER_CMD="$REMOTE_SERVER_CMD"
    echo "  ✓ .ccdev config found: SERVER_CMD set"
  fi
fi

# --- Prüfe entr auf Remote wenn SERVER_CMD gesetzt ---
if [[ -n "$SERVER_CMD" ]]; then
  ENTR_OK=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}" 'command -v entr &>/dev/null && echo yes || echo no' 2>/dev/null || echo "no")
  if [[ "$ENTR_OK" != "yes" ]]; then
    echo "  ⚠ entr not found on the remote (useful to auto-restart the dev server)"
    read -rp "  Install entr on ${SSH_TARGET} (sudo apt-get)? [y/N] " REPLY
    if [[ "$REPLY" =~ ^[yYjJ]$ ]]; then
      ssh -t "${SSH_TARGET}" "sudo apt-get update -qq && sudo apt-get install -y entr"
      echo "  ✓ entr installed"
    fi
  fi
fi

# This script runs on the remote host.
# Kopf: Einstellungen sauber quotiert; Rumpf: Programm unverändert (quoted heredoc, keine \$-Maskierung nötig).
REMOTE_HEAD=$(printf 'BYOBU_SESSION=%q\nREMOTE_DIR=%q\nSTART=%q\nSERVER_CMD=%q\nBASE_DIR=%q\nRESTORE=%q\nPERM_MODE=%q\n' \
  "$BYOBU_SESSION" "$REMOTE_DIR" "$START" "$SERVER_CMD" "$BASE_DIR" "$RESTORE" "$PERM_MODE")
REMOTE_BODY=$(cat <<'REMOTE'
set -euo pipefail

# Wird von ccdev auf dem Zielrechner ausgeführt. Davor setzt ccdev:
# BYOBU_SESSION REMOTE_DIR START SERVER_CMD BASE_DIR RESTORE PERM_MODE
BASE_DIR="${BASE_DIR:-$HOME}"
CLAUDE="claude${PERM_MODE:+ --permission-mode $PERM_MODE}"
[[ "$BASE_DIR" != /* ]] && BASE_DIR="$HOME/$BASE_DIR"   # relativ = unter dem $HOME des Zielrechners
CD_CMD=""
[[ -n "$REMOTE_DIR" ]] && CD_CMD="cd $(printf '%q' "$REMOTE_DIR") && "

# --- Projekte: Unterordner von BASE_DIR mit CLAUDE.md oder .ccdev ---
proj_key()     { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }        # Claude-Projektordner-Name
proj_hist()    { echo "$HOME/.claude/projects/$(proj_key "$1")"; }
has_history()  { ls "$(proj_hist "$1")"/*.jsonl >/dev/null 2>&1; }
last_activity() {
  local f; f=$(ls -t "$(proj_hist "$1")"/*.jsonl 2>/dev/null | head -1 || true)
  if [[ -n "$f" ]]; then date -r "$f" +%Y-%m-%d; else echo "new"; fi
}
sname() { local n; n=$(basename "$1"); echo "${n//[.:]/_}"; }
abs_dir() { local d="${1:-$HOME}"; [[ "$d" == /* ]] || d="$HOME/$d"; echo "$d"; }

# Claude-Aufruf für einen Ordner: letzte Unterhaltung fortsetzen (Standard), neu (fresh) oder auswählen (pick)
claude_cmd() {
  case "$START" in
    fresh) echo "$CLAUDE" ;;
    pick)  echo "$CLAUDE --resume" ;;
    *)     if has_history "$1"; then echo "$CLAUDE --continue"; else echo "$CLAUDE"; fi ;;
  esac
}
start_desc() {
  case "$1" in
    *--continue) echo "last conversation continued" ;;
    *--resume)   echo "pick a conversation" ;;
    *)           echo "new conversation" ;;
  esac
}

list_projects() {   # nur Projekte ohne laufende byobu-Session
  local d
  for d in "$BASE_DIR"/*/; do
    d="${d%/}"
    [[ -f "$d/CLAUDE.md" || -f "$d/.ccdev" ]] || continue
    byobu has-session -t "=$(sname "$d")" 2>/dev/null && continue
    echo "$d"
  done
}

start_project() {   # $1 = Projektordner; startet die byobu-Session im Hintergrund
  local d="$1" n srv cl qd
  n=$(sname "$d"); qd=$(printf '%q' "$d")
  byobu has-session -t "=$n" 2>/dev/null && return 0
  byobu new-session -d -s "$n" -c "$d"
  srv=""
  [[ -f "$d/.ccdev" ]] && srv=$(bash -c '. "$1/.ccdev" >/dev/null 2>&1; echo "${SERVER_CMD:-}"' _ "$d")
  cl=$(claude_cmd "$d")
  if [[ -n "$srv" ]]; then
    byobu split-window -h -t "$n:0"
    byobu send-keys -t "$n:0.1" "cd $qd && $srv" Enter
    byobu send-keys -t "$n:0.0" "cd $qd && $cl" Enter
  else
    byobu send-keys -t "$n:0" "cd $qd && $cl" Enter
  fi
  echo "  ✓ started: $n  ($d, $(start_desc "$cl"))"
}

restore_all() {
  local d any=0
  while IFS= read -r d; do [[ -n "$d" ]] && { start_project "$d"; any=1; }; done < <(list_projects)
  [[ $any -eq 1 ]] || echo "  (no saved projects without a running session)"
}

new_session() {
  if byobu has-session -t "=${BYOBU_SESSION}" 2>/dev/null; then
    echo "→ byobu session '${BYOBU_SESSION}' already exists, attaching …"
    byobu attach-session -t "=${BYOBU_SESSION}"
    return
  fi
  echo "→ Starting new byobu session '${BYOBU_SESSION}' …"
  byobu new-session -s "${BYOBU_SESSION}" -d
  local cl
  cl=$(claude_cmd "$(abs_dir "$REMOTE_DIR")")
  if [[ -n "${SERVER_CMD}" ]]; then
    # Split-Pane Layout: Claude links, Server rechts
    byobu split-window -h -t "${BYOBU_SESSION}:0"
    byobu send-keys -t "${BYOBU_SESSION}:0.1" "${CD_CMD}${SERVER_CMD}" Enter
    byobu send-keys -t "${BYOBU_SESSION}:0.0" "${CD_CMD}${cl}" Enter
  else
    byobu send-keys -t "${BYOBU_SESSION}:0" "${CD_CMD}${cl}" Enter
  fi
  byobu attach-session -t "=${BYOBU_SESSION}"
}

# --- Menü ---
SESSION_NAMES=(); PROJECTS=()
load_lists() {
  SESSION_NAMES=(); PROJECTS=()
  local s
  while IFS= read -r s; do [[ -n "$s" ]] && SESSION_NAMES+=("$s"); done < <(byobu list-sessions -F '#{session_name}' 2>/dev/null || true)
  while IFS= read -r s; do [[ -n "$s" ]] && PROJECTS+=("$s"); done < <(list_projects)
}
show_menu() {
  local i=1 s line info
  echo ""
  if [[ ${#SESSION_NAMES[@]} -gt 0 ]]; then
    echo "Running byobu sessions:"
    echo "──────────────────────────────────────"
    while IFS= read -r line; do
      [[ -n "$line" ]] && echo "  [$i] $line" && i=$((i + 1))
    done < <(byobu list-sessions 2>/dev/null || true)
  fi
  if [[ ${#PROJECTS[@]} -gt 0 ]]; then
    echo "Saved projects (not started) in $BASE_DIR:"
    echo "──────────────────────────────────────"
    for s in "${PROJECTS[@]}"; do
      if has_history "$s"; then info="last used $(last_activity "$s")"; else info="no history yet"; fi
      printf "  [%d] %-14s %s, %s\n" "$i" "$(sname "$s")" "$s" "$info"
      i=$((i + 1))
    done
  fi
  echo "──────────────────────────────────────"
  [[ ${#PROJECTS[@]} -gt 0 ]] && echo "  [r] Start all saved projects"
  echo "  [n] New session"
  echo "  [q] Quit"
  echo ""
}

if [[ "${RESTORE}" -eq 1 ]]; then
  echo "→ Starting all saved projects in $BASE_DIR …"
  restore_all
fi

load_lists
if [[ ${#SESSION_NAMES[@]} -eq 0 && ${#PROJECTS[@]} -eq 0 ]]; then
  echo "No byobu sessions found."
  new_session
  exit 0
fi
if [[ ${#SESSION_NAMES[@]} -eq 0 && -n "$REMOTE_DIR" ]]; then
  new_session          # wie bisher: mit Verzeichnis und ohne laufende Sessions direkt starten
  exit 0
fi

show_menu
while true; do
  read -rp "Choice: " CHOICE
  NS=${#SESSION_NAMES[@]}; NP=${#PROJECTS[@]}

  if [[ "$CHOICE" == "q" ]]; then
    echo "Bye."
    exit 0
  fi

  if [[ "$CHOICE" == "r" && $NP -gt 0 ]]; then
    restore_all
    load_lists; show_menu
    continue
  fi

  if [[ "$CHOICE" == "n" ]]; then
    read -rp "Name of the new session [${BYOBU_SESSION}]: " NAME
    NAME="${NAME:-$BYOBU_SESSION}"
    BYOBU_SESSION="${NAME//[.:]/_}"
    new_session
    exit 0
  fi

  if [[ "$CHOICE" =~ ^[0-9]+$ ]] && (( CHOICE >= 1 && CHOICE <= NS + NP )); then
    if (( CHOICE > NS )); then
      P="${PROJECTS[$(( CHOICE - NS - 1 ))]}"
      start_project "$P"
      byobu attach-session -t "=$(sname "$P")"
      exit 0
    fi
    SELECTED="${SESSION_NAMES[$(( CHOICE - 1 ))]}"
    echo ""
    echo "  [a] Attach"
    echo "  [k] Kill"
    echo "  [b] Back"
    read -rp "Action for '$SELECTED': " ACTION
    case "$ACTION" in
      a)
        byobu attach-session -t "=$SELECTED"
        exit 0
        ;;
      k)
        byobu kill-session -t "=$SELECTED"
        echo "Session '$SELECTED' killed."
        load_lists
        if [[ ${#SESSION_NAMES[@]} -eq 0 && ${#PROJECTS[@]} -eq 0 ]]; then
          echo "No sessions left."
          read -rp "Start a new session? [y/n]: " YN
          [[ "$YN" == [yYjJ]* ]] && new_session
          exit 0
        fi
        show_menu
        ;;
      b)
        show_menu
        ;;
      *)
        echo "Invalid action."
        ;;
    esac
  else
    echo "Invalid choice."
  fi
done
REMOTE
)
REMOTE_CMD="#!/usr/bin/env bash
${REMOTE_HEAD}
${REMOTE_BODY}"

QUOTED_CMD="$(printf '%q' "$REMOTE_CMD")"

# --- Preflight: Lokale Dependencies ---
LOCAL_FAIL=0
for tool in ssh scp; do   # mosh ist optional, ohne mosh wird ssh benutzt
  if ! command -v "$tool" &>/dev/null; then
    echo "✗ Missing locally: $tool" >&2
    LOCAL_FAIL=1
  fi
done
[[ "$LOCAL_FAIL" -eq 1 ]] && exit 1

# --- Preflight: Remote Dependencies ---
echo "🔍 Checking remote dependencies on ${SSH_TARGET}…"
REMOTE_CHECK=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}" \
  'export PATH="$HOME/.npm-global/bin:$PATH"; MISSING=(); for t in byobu mosh-server claude; do command -v "$t" &>/dev/null || MISSING+=("$t"); done; echo "${MISSING[*]}"' 2>&1)
SSH_RC=$?

if [[ "$SSH_RC" -ne 0 ]]; then
  echo "✗ SSH connection to ${SSH_TARGET} failed:" >&2
  echo "  $REMOTE_CHECK" >&2
  exit 1
fi

if [[ -n "$REMOTE_CHECK" ]]; then
  echo "✗ Missing on the remote: $REMOTE_CHECK"
  echo ""

  APT_MISSING=""
  CLAUDE_MISSING=0
  for t in $REMOTE_CHECK; do
    case "$t" in
      claude)      CLAUDE_MISSING=1 ;;
      mosh-server) APT_MISSING="$APT_MISSING mosh" ;;
      *)           APT_MISSING="$APT_MISSING $t" ;;
    esac
  done

  read -rp "  Install now on ${SSH_TARGET} (sudo apt-get; Node.js via NodeSource if needed; claude via npm)? [y/N] " REPLY
  if [[ ! "$REPLY" =~ ^[yYjJ]$ ]]; then
    echo "Aborted." >&2
    exit 1
  fi

  if [[ -n "$APT_MISSING" ]]; then
    echo "  ⬇ Installing via apt:${APT_MISSING}…"
    ssh -t "${SSH_TARGET}" "sudo apt-get update -qq && sudo apt-get install -y${APT_MISSING}"
  fi

  if [[ "$CLAUDE_MISSING" -eq 1 ]]; then
    echo "  ⬇ Checking Node.js…"
    ssh -t "${SSH_TARGET}" 'bash -lc "
      NODE_OK=0
      if command -v node &>/dev/null; then
        NODE_VER=\$(node -e \"process.stdout.write(process.version.slice(1).split(\\\".\\\")[0])\")
        [ \"\$NODE_VER\" -ge 18 ] && NODE_OK=1
      fi
      if [ \"\$NODE_OK\" -eq 0 ]; then
        echo \"  ⬇ Installing Node.js 20...\"
        curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -
        sudo apt-get install -y nodejs
      else
        echo \"  ✓ Node.js \$(node --version)\"
      fi
      # npm sicherstellen (Ubuntu apt nodejs enthält es nicht immer)
      if ! command -v npm &>/dev/null; then
        echo \"  ⬇ Installing npm...\"
        sudo apt-get install -y npm
      fi
      echo \"  ⬇ Setting npm prefix...\"
      mkdir -p ~/.npm-global
      npm config set prefix ~/.npm-global
      echo \"  ⬇ Installing claude...\"
      PATH=\"\$HOME/.npm-global/bin:\$PATH\" npm install -g @anthropic-ai/claude-code
      grep -qxF \"export PATH=\\\"\\\$HOME/.npm-global/bin:\\\$PATH\\\"\" ~/.bashrc \
        || echo \"export PATH=\\\"\\\$HOME/.npm-global/bin:\\\$PATH\\\"\" >> ~/.bashrc
      echo \"  ✓ claude installed\"
    "'
  fi

  # Nochmal prüfen ob Installation erfolgreich war
  echo ""
  echo "🔍 Checking again…"
  REMOTE_CHECK=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}" \
    'export PATH="$HOME/.npm-global/bin:$PATH"; MISSING=(); for t in byobu mosh-server claude; do command -v "$t" &>/dev/null || MISSING+=("$t"); done; echo "${MISSING[*]}"' 2>&1)
  if [[ -n "$REMOTE_CHECK" ]]; then
    echo "✗ Installation failed, still missing: $REMOTE_CHECK" >&2
    exit 1
  fi
fi
echo "  ✓ Remote dependencies OK"
echo ""


# --- Claude Auth prüfen und ggf. von lokal übertragen ---
if [[ "$SYNC_AUTH" -eq 1 ]]; then
echo "🔑 Checking Claude auth on ${SSH_TARGET}…"
REMOTE_AUTH=$(ssh -o ConnectTimeout=5 "${SSH_TARGET}"   'test -f ~/.claude/.credentials.json && echo "ok" || (grep -q "oauthAccount\|apiKey" ~/.claude/settings.json 2>/dev/null && echo "ok" || echo "missing")' 2>/dev/null || echo "missing")

if [[ "$REMOTE_AUTH" != "ok" ]]; then
  echo "  ⚠ No Claude auth found on the remote"

  # Nur die Anmeldung übertragen, nie die settings.json (sie würde die Einstellungen auf dem Host überschreiben)
  if [[ ! -f "$HOME/.claude/.credentials.json" ]]; then
    echo "  ✗ No local login to copy (~/.claude/.credentials.json)." >&2
    echo "    Run 'claude' locally and log in first, or log in on the host (an API key" >&2
    echo "    can be set there via ANTHROPIC_API_KEY)." >&2
    exit 1
  fi

  read -rp "  Copy your local login (~/.claude/.credentials.json) to ${SSH_TARGET}? [y/N] " REPLY
  if [[ "$REPLY" =~ ^[yYjJ]$ ]]; then
    echo "  ⬆ Copying ~/.claude/.credentials.json…"
    ssh "${SSH_TARGET}" "mkdir -p ~/.claude && chmod 700 ~/.claude"
    scp -q "$HOME/.claude/.credentials.json" "${SSH_TARGET}:~/.claude/.credentials.json"
    ssh "${SSH_TARGET}" "chmod 600 ~/.claude/.credentials.json"
    echo "  ✓ Login copied"
  else
    echo "  ⚠ Login not copied, claude will ask you to log in"
  fi
else
  echo "  ✓ Claude auth OK"
fi
fi
echo ""

# --- Screenshot-Watcher ---
INOTIFY_PID=""
LOOP_PID=""
WATCH_FIFO=""
if [[ "$NO_SCREENSHOTS" -eq 0 ]]; then
  if ! command -v inotifywait &>/dev/null; then
    echo "⚠ inotifywait not found, screenshot sync disabled (install inotify-tools or use --no-screenshots)"
  elif [[ ! -d "$LOCAL_SCREENSHOT_DIR" ]]; then
    echo "⚠ Screenshot dir not found: $LOCAL_SCREENSHOT_DIR, screenshot sync disabled"
  else
    # Remote-Ziel: screenshots/ im Projektverzeichnis, oder ~/screenshots als Fallback
    if [[ -n "$REMOTE_DIR" ]]; then
      REMOTE_SCREENSHOT_DIR="${REMOTE_DIR}/screenshots"
    else
      REMOTE_SCREENSHOT_DIR="~/screenshots"
    fi

    ssh "${SSH_TARGET}" "mkdir -p ${REMOTE_SCREENSHOT_DIR}" 2>/dev/null

    # --- /ss Slash-Command auf Remote anlegen ---
    # Projektspezifisch wenn REMOTE_DIR gesetzt, sonst global
    if [[ -n "$REMOTE_DIR" ]]; then
      SS_CMD_DIR="${REMOTE_DIR}/.claude/commands"
    else
      SS_CMD_DIR="~/.claude/commands"
    fi

    TMPSS=$(mktemp)
    cat > "$TMPSS" <<SSEOF
Look at the newest screenshots in ${REMOTE_SCREENSHOT_DIR}/.
Sort by file name, descending (newest first).

If \$ARGUMENTS is a number, read that many of the newest screenshots.
If \$ARGUMENTS is text, read the newest screenshot and answer the question about it.
If \$ARGUMENTS is empty, read the newest screenshot and describe what you see.
SSEOF
    ssh "${SSH_TARGET}" "mkdir -p ${SS_CMD_DIR}" 2>/dev/null
    scp -q "$TMPSS" "${SSH_TARGET}:${SS_CMD_DIR}/ss.md"
    rm -f "$TMPSS"
    echo "  ✓ /ss slash command created on the remote (${SS_CMD_DIR})"

    echo "📸 Screenshot watcher active → ${SSH_TARGET}:${REMOTE_SCREENSHOT_DIR}"

    # close_write deckt Tools ab, die direkt schreiben (GNOME);
    # moved_to deckt Tools ab, die in eine Temp-Datei schreiben und atomar
    # umbenennen (Flameshot, Spectacle, KDE …).
    # inotifywait und die Sync-Schleife laufen als getrennte Prozesse über
    # einen FIFO, damit beim Cleanup BEIDE PIDs eindeutig bekannt sind und
    # inotifywait nicht verwaist zurückbleibt.
    WATCH_FIFO=$(mktemp -u)
    mkfifo "$WATCH_FIFO"

    inotifywait -m -e close_write -e moved_to "$LOCAL_SCREENSHOT_DIR" \
      --format '%f' 2>/dev/null > "$WATCH_FIFO" &
    INOTIFY_PID=$!

    (
      while read -r FILE; do
        DATETIME=$(date '+%Y%m%d-%H%M%S')
        DEST="${REMOTE_SCREENSHOT_DIR}/cp-${DATETIME}.png"
        scp "$LOCAL_SCREENSHOT_DIR/$FILE" "${SSH_TARGET}:${DEST}" 2>/dev/null \
          && ssh "${SSH_TARGET}" "echo \"\$(date +%H:%M:%S) ✓ $FILE → ${DEST}\" >> ${REMOTE_SCREENSHOT_DIR}/../cc-watcher.log"
      done < "$WATCH_FIFO"
    ) &
    LOOP_PID=$!
  fi
fi

cleanup() {
  [[ -n "$INOTIFY_PID" ]] && kill "$INOTIFY_PID" 2>/dev/null
  [[ -n "$LOOP_PID" ]]    && kill "$LOOP_PID" 2>/dev/null
  wait "$INOTIFY_PID" "$LOOP_PID" 2>/dev/null
  [[ -n "$WATCH_FIFO" ]] && rm -f "$WATCH_FIFO"
  [[ -n "$INOTIFY_PID$LOOP_PID" ]] && echo "🛑 Screenshot watcher stopped"
}
trap cleanup EXIT

if [[ $USE_MOSH -eq 1 ]]; then
  echo "→ Connecting to ${SSH_TARGET} via mosh …"
  mosh "$SSH_TARGET" -- bash -lc "$REMOTE_CMD"
else
  echo "→ Connecting to ${SSH_TARGET} via $TRANSPORT_WHY …"
  ssh -t "$SSH_TARGET" "bash -lc ${QUOTED_CMD}"
fi
